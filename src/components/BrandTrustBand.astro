---
interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  disclaimer?: string;
}

const {
  eyebrow = 'Trusted Compatibility & OEM Support',
  title = 'Compatible with Leading Global Equipment Brands',
  subtitle = 'Precision wear parts, bucket teeth and custom casting solutions engineered for industry-standard machinery.',
  disclaimer = '* All brand names, logos, and model references are used solely for identification and compatibility matching purposes.',
} = Astro.props;

// Row 1: Excavators & Heavy Earthmoving Equipment
const ROW_1 = [
  { name: 'CATERPILLAR', logo: '/images/logos/caterpillar.webp' },
  { name: 'KOMATSU', logo: '/images/logos/komatsu.webp' },
  { name: 'LIEBHERR', logo: '/images/logos/liebherr.webp' },
  { name: 'DOOSAN', logo: '/images/logos/doosan.webp' },
  { name: 'SANY', logo: '/images/logos/sany.webp' },
  { name: 'XCMG', logo: '/images/logos/xcmg.webp' },
  { name: 'LIUGONG', logo: '/images/logos/liugong.webp' },
  { name: 'SDLG', logo: '/images/logos/sdlg.webp' },
];

// Row 2: Crushing Circuits, Mining & Heavy Plant
const ROW_2 = [
  { name: 'SBM', logo: '/images/logos/sbm.webp' },
  { name: 'LIMING', logo: '/images/logos/liming.webp' },
  { name: 'SHANBAO', logo: '/images/logos/shanbao.webp' },
  { name: 'CITIC HEAVY', logo: '/images/logos/citic-heavy.webp' },
  { name: 'CREC', logo: '/images/logos/crec.webp' },
  { name: 'LONKING', logo: '/images/logos/lonking.webp' },
  { name: 'XGMA', logo: '/images/logos/xgma.webp' },
  { name: 'YUTONG', logo: '/images/logos/yutong.webp' },
];
---

<section class="section brand-trust-section">
  <div class="container">
    <div class="sec-head center">
      <span class="eyebrow">{eyebrow}</span>
      <h2>{title}</h2>
      <p>{subtitle}</p>
    </div>

    <div class="logo-wall">
      <!-- Row 1 -->
      <div class="logo-row">
        {ROW_1.map((b) => (
          <div class="logo-item" title={b.name}>
            <img 
              src={b.logo} 
              alt={`${b.name} compatible equipment logo`} 
              loading="lazy" 
              width="180" 
              height="60" 
            />
          </div>
        ))}
      </div>

      <!-- Row 2 -->
      <div class="logo-row">
        {ROW_2.map((b) => (
          <div class="logo-item" title={b.name}>
            <img 
              src={b.logo} 
              alt={`${b.name} compatible equipment logo`} 
              loading="lazy" 
              width="180" 
              height="60" 
            />
          </div>
        ))}
      </div>
    </div>

    <p class="brand-disclaimer center">
      {disclaimer}
    </p>
  </div>
</section>

<style>
  .brand-trust-section {
    background: #ffffff;
    border-top: 1px solid #f1f5f9;
    border-bottom: 1px solid #f1f5f9;
    padding: 64px 0 52px;
  }

  .logo-wall {
    display: flex;
    flex-direction: column;
    gap: 32px;
    margin-top: 40px;
    margin-bottom: 28px;
  }

  .logo-row {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    align-items: center;
    justify-items: center;
    gap: 24px 16px;
  }

  .logo-item {
    width: 100%;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px 8px;
    cursor: default;
  }

  .logo-item img {
    max-width: 100%;
    max-height: 44px;
    width: auto;
    height: auto;
    object-fit: contain;
    /* Subtle minimalist grayscale style, consistent with high-end references */
    filter: grayscale(100%);
    opacity: 0.65;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .logo-item:hover img {
    filter: grayscale(0%);
    opacity: 1;
    transform: scale(1.08);
  }

  .brand-disclaimer {
    font-size: 0.76rem;
    color: #94a3b8;
    max-width: 760px;
    margin: 0 auto;
    line-height: 1.5;
  }

  /* Responsive layout for smaller viewports */
  @media (max-width: 1100px) {
    .logo-row {
      grid-template-columns: repeat(4, 1fr);
      gap: 24px 20px;
    }
    .logo-item {
      height: 48px;
    }
  }

  @media (max-width: 640px) {
    .brand-trust-section {
      padding: 48px 0 36px;
    }
    .logo-wall {
      gap: 20px;
      margin-top: 28px;
    }
    .logo-row {
      grid-template-columns: repeat(4, 1fr);
      gap: 16px 10px;
    }
    .logo-item {
      height: 40px;
      padding: 2px 4px;
    }
    .logo-item img {
      max-height: 36px;
      opacity: 0.75;
    }
  }

  @media (max-width: 420px) {
    .logo-row {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px 12px;
    }
  }
</style>
