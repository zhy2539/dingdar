---
interface Props {
  title: string;
  text: string;
  cta: string;
  href?: string;
  btn?: 'primary' | 'light';
}
import { langPath, type Lang } from '../i18n';
const { title, text, cta, href = '/contact/', btn = 'primary' } = Astro.props;

// Contact CTAs open the quick-inquiry modal, so they need the locale-aware URL
// even when the caller passes the bare '/contact/'.
const seg = Astro.url.pathname.split('/')[1];
const curLang = (['es', 'fr', 'pt', 'ru'].includes(seg) ? seg : 'en') as Lang;
const isContact = href.endsWith('/contact/');
const target = isContact ? langPath(curLang, '/contact/') : href;
---

<section class="section">
  <div class="container">
    <div class="cta-band">
      <div>
        <h2>{title}</h2>
        <p>{text}</p>
      </div>
      {
        isContact ? (
          <a href={target} class:list={['btn', btn === 'primary' ? 'btn--primary' : 'btn--light', 'btn--lg']} data-modal-open>{cta}</a>
        ) : (
          <a href={target} class:list={['btn', btn === 'primary' ? 'btn--primary' : 'btn--light', 'btn--lg']}>{cta}</a>
        )
      }
    </div>
  </div>
</section>
