---
interface Fact { value: string; label: string }
interface Props { items: Fact[] }
const { items } = Astro.props;
---

<section class="fact-bar" aria-label="Company facts">
  <div class="container fact-bar__inner">
    {items.map((f) => {
      const digits = f.value.match(/[0-9]+/g)?.join('') || '';
      const suffix = f.value.replace(/[0-9,]/g, '');
      return (
        <div class="fact">
          <div class="fact-num"
            data-target={digits}
            data-suffix={suffix}
            data-static={digits === '1986' ? '1986' : ''}
          >{digits === '1986' ? '1986' : '0'}</div>
          <div class="fact-lab">{f.label}</div>
        </div>
      );
    })}
  </div>
</section>

<script>
  function fmt(n: number): string {
    return n.toLocaleString('en-US');
  }
  const els = document.querySelectorAll<HTMLElement>('.fact-num');
  const io = new IntersectionObserver((entries) => {
    for (const en of entries) {
      if (!en.isIntersecting) continue;
      const el = en.target as HTMLElement;
      io.unobserve(el);
      const staticV = el.dataset.static;
      if (staticV) { el.textContent = staticV; continue; }
      const target = parseInt(el.dataset.target || '0', 10);
      const suffix = el.dataset.suffix || '';
      const dur = 1300;
      const start = performance.now();
      const tick = (now: number) => {
        const p = Math.min((now - start) / dur, 1);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = fmt(Math.round(target * eased)) + suffix;
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
  }, { threshold: 0.4 });
  els.forEach((el) => io.observe(el));
</script>
