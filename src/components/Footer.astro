---
import { SITE } from '../data/config';
import { getT, langPath, type Lang, type AnyLang } from '../i18n';
const year = new Date().getFullYear();

interface Props {
  lang?: AnyLang;
  enPath?: string;
}
const { lang = 'en', enPath = '/' } = Astro.props;
const t = lang === 'en' ? null : getT(lang as Lang);
const l = (key: string) => (t ? t(key) : '');
const hrefOf = (href: string) => (lang === 'en' ? href : langPath(lang as Lang, href));

const productLinks = [
  { href: '/products/jaw-crusher-wear-parts/', key: 'p.jaw-crusher-wear-parts.cardTitle' },
  { href: '/products/cone-crusher-wear-parts/', key: 'p.cone-crusher-wear-parts.cardTitle' },
  { href: '/products/impact-crusher-wear-parts/', key: 'p.impact-crusher-wear-parts.cardTitle' },
  { href: '/products/hammer-crusher-wear-parts/', key: 'p.hammer-crusher-wear-parts.cardTitle' },
  { href: '/products/bucket-teeth-adapters/', key: 'p.bucket-teeth-adapters.cardTitle' },
  { href: '/products/custom-castings/', key: 'p.custom-castings.cardTitle' },
  { href: '/about/#oem', key: 'footer.p6' },
];
const companyLinks = [
  { href: '/about/', key: 'footer.aboutUs' },
  { href: '/about/#compliance', key: 'footer.compliance' },
  { href: '/resources/', key: 'footer.resources' },
  { href: '/request-sample/', key: 'footer.requestSample' },
  { href: '/processes/', key: 'footer.processes' },
  { href: '/news/', key: 'footer.news' },
  { href: '/faq/', key: 'footer.faq' },
  { href: '/contact/', key: 'footer.contactLink' },
];
---

<footer class="footer">
  <div class="container">
    <div class="cols">
      <div class="brand">
        <div class="brand-row">
          <img src="/images/logo.png" alt="DINGDAR logo" width="40" height="40" />
          <span class="brand-name">DINGDAR<span>Castings</span></span>
        </div>
        <p>
          Casting manufacturer for mining, quarrying and heavy equipment since 1986.
          Crusher wear parts, bucket teeth and custom castings — reviewed as one project,
          from drawing to inspection and delivery.
        </p>
      </div>
      <div>
        <h4>{l('footer.products')}</h4>
        <ul class="links">
          {productLinks.map((x) => (
            <li><a href={hrefOf(x.href)}>{l(x.key)}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4>{l('footer.company')}</h4>
        <ul class="links">
          {companyLinks.map((x) => (
            <li><a href={hrefOf(x.href)}>{l(x.key)}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4>{l('footer.legal')}</h4>
        <ul class="links">
          <li><a href={hrefOf('/privacy/')}>{l('footer.privacy')}</a></li>
        </ul>
      </div>
      <div>
        <h4>{l('footer.contactT')}</h4>
        <ul class="contact">
          <li>📍 {SITE.location}</li>
          <li>📧 <a href={'mailto:' + SITE.email}>{SITE.email}</a></li>
          <li>💬 <a href={'https://wa.me/' + SITE.whatsappTel}>WhatsApp {SITE.whatsapp}</a></li>
          <li>⚡ {SITE.responsePromise}</li>
        </ul>
      </div>
    </div>
    <div class="bottom">
      <span>© {year} {SITE.legalName}. All rights reserved.</span>
      <span>{SITE.domain}</span>
    </div>
  </div>
</footer>

<style>
  .footer .brand-row { display: flex; align-items: center; gap: 10px; }
  .footer .brand img { border-radius: 8px; }
  .footer .brand-name { font-weight: 800; color: #fff; font-size: 1.2rem; display: flex; align-items: baseline; gap: 8px; }
  .footer .brand-name span { font-size: 0.66rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }
</style>
