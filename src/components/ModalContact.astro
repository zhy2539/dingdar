---
import { SITE } from '../data/config';

const fields = [
  { name: 'name', label: 'Your Name *', type: 'text', required: true, placeholder: 'Full name' },
  { name: 'email', label: 'Work Email *', type: 'email', required: true, placeholder: 'name@company.com' },
  { name: 'company', label: 'Company *', type: 'text', required: true, placeholder: 'Company name' },
  { name: 'country', label: 'Country', type: 'text', required: false, placeholder: 'Country / region' },
  { name: 'product', label: 'Product Interest', type: 'select', required: false, options: [
    'Jaw crusher wear parts',
    'Cone crusher wear parts',
    'Impact crusher wear parts',
    'Hammer crusher wear parts',
    'Double roll crusher parts',
    'Bucket teeth & adapters',
    'Custom castings',
    'Other / not sure yet',
  ] },
  { name: 'message', label: 'Message *', type: 'textarea', required: true, placeholder: 'Part number, drawing, equipment model, material or working conditions — whatever you have.' },
];
---

<div class="mc-modal" data-mc-modal aria-hidden="true">
  <div class="mc-overlay" data-mc-close></div>
  <div class="mc-card" role="dialog" aria-modal="true" aria-labelledby="mc-title">
    <button class="mc-close" data-mc-close aria-label="Close">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
    <h3 id="mc-title" style="font-size:1.4rem;margin-bottom:8px;">Request a Quote</h3>
    <p style="font-size:0.9rem;color:var(--muted);margin-bottom:22px;">Fields marked * are required. We reply with technical feedback within 12–24 hours.</p>

    <form data-mc-form action={SITE.formEndpoint} method="POST" novalidate>
      <div class="hp-field" aria-hidden="true">
        <label>Leave this field empty</label>
        <input type="text" name="_honey" tabindex="-1" autocomplete="off" />
      </div>
      <input type="hidden" name="_subject" value="New inquiry from dingdar.com" />

      <div class="mc-grid">
        {fields.map((f) => (
          f.type === 'select' ? (
            <div class="field mc-wide">
              <label for={'mc-' + f.name}>{f.label}</label>
              <select id={'mc-' + f.name} name={f.name}>
                <option value="">Select a category</option>
                {f.options.map((o) => <option value={o}>{o}</option>)}
              </select>
            </div>
          ) : f.type === 'textarea' ? (
            <div class="field mc-wide">
              <label for={'mc-' + f.name}>{f.label}</label>
              <textarea id={'mc-' + f.name} name={f.name} rows="4" placeholder={f.placeholder} required={f.required}></textarea>
            </div>
          ) : (
            <div class="field">
              <label for={'mc-' + f.name}>{f.label}</label>
              <input id={'mc-' + f.name} name={f.name} type={f.type} placeholder={f.placeholder} required={f.required} />
            </div>
          )
        ))}
      </div>

      <button type="submit" class="btn btn--primary btn--lg" style="width:100%;">Send Inquiry</button>
      <p class="hint" data-mc-status role="status" aria-live="polite"></p>
    </form>
  </div>
</div>

<style>
  .mc-modal {
    position: fixed; inset: 0; z-index: 200;
    display: none; align-items: flex-start; justify-content: center;
    padding: 6vh 20px 20px;
  }
  .mc-modal.open { display: flex; }
  .mc-overlay { position: absolute; inset: 0; background: rgba(9, 20, 32, 0.55); backdrop-filter: blur(2px); }
  .mc-card {
    position: relative; z-index: 1;
    width: 100%; max-width: 560px;
    background: #fff; border-radius: 16px;
    padding: 32px 30px 26px;
    box-shadow: 0 24px 70px rgba(6, 14, 22, 0.35);
    max-height: 86vh; overflow-y: auto;
  }
  .mc-close {
    position: absolute; top: 14px; right: 14px;
    width: 34px; height: 34px; border-radius: 50%;
    border: none; background: var(--bg-tint); color: var(--ink);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; transition: background 0.15s;
  }
  .mc-close:hover { background: var(--line); }
  .mc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 16px; }
  .mc-wide { grid-column: 1 / -1; }
  .mc-card .btn { margin-top: 4px; }
  .mc-card .hint { margin-top: 10px; font-size: 0.84rem; }
  @media (max-width: 640px) {
    .mc-grid { grid-template-columns: 1fr; }
    .mc-wide { grid-column: auto; }
    .mc-modal { padding: 4vh 12px 12px; }
  }
</style>

<script>
  const modal = document.querySelector('[data-mc-modal]');
  const form = modal?.querySelector('[data-mc-form]');
  const status = modal?.querySelector('[data-mc-status]');
  const endpoint = form?.getAttribute('action') || '';

  function openModal() { modal?.classList.add('open'); modal?.setAttribute('aria-hidden', 'false'); }
  function closeModal() { modal?.classList.remove('open'); modal?.setAttribute('aria-hidden', 'true'); }

  document.addEventListener('click', (e) => {
    const btn = e.target && e.target.closest ? e.target.closest('[data-modal-open]') : null;
    if (btn) { e.preventDefault(); openModal(); }
  });
  document.querySelectorAll('[data-mc-close]').forEach((el) => el.addEventListener('click', closeModal));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (status) { status.textContent = ''; }
    const data = new FormData(form);
    if (data.get('_honey')) return;
    const name = data.get('name')?.trim();
    const email = data.get('email')?.trim();
    const company = data.get('company')?.trim();
    const message = data.get('message')?.trim();
    if (!name || !email || !company || !message) {
      if (status) { status.textContent = 'Please complete all required fields.'; status.style.color = '#d9480f'; }
      return;
    }
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
      if (status) { status.textContent = 'Please enter a valid email address.'; status.style.color = '#d9480f'; }
      return;
    }
    if (!endpoint) {
      if (status) {
        status.innerHTML = 'The form endpoint is not configured yet. Please contact us directly: <a href="mailto:sales@hndingdar.com" style="color:#e8590c;font-weight:700;">sales@hndingdar.com</a> or WhatsApp +86 19337861987.';
      }
      return;
    }
    try {
      const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      if (res.ok) {
        try { window.dataLayer?.push?.({ event: 'inquiry_submitted' }); } catch {}
        window.location.href = '/thank-you/';
      } else {
        if (status) { status.textContent = 'Something went wrong. Please try again or use WhatsApp / email.'; status.style.color = '#d9480f'; }
      }
    } catch {
      if (status) { status.textContent = 'Network error. Please email sales@hndingdar.com or message us on WhatsApp.'; status.style.color = '#d9480f'; }
    }
  });
</script>
