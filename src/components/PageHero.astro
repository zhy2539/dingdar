---
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  img?: string;
  imgAlt?: string;
  ctaPrimary?: { label: string; href: string };
  ctaSecondary?: { label: string; href: string };
  trust?: string[];
}
const { eyebrow, title, lead, img, imgAlt, ctaPrimary, ctaSecondary, trust } = Astro.props;
---

<section class="hero">
  <div class="hero-bg">
    {img ? (
      <img src={img} alt={imgAlt || title} />
    ) : (
      <div class="hero-bg-fallback" aria-hidden="true"></div>
    )}
    <div class="hero-overlay" aria-hidden="true"></div>
  </div>
  <div class="container hero-inner">
    <span class="eyebrow">{eyebrow}</span>
    <h1>{title}</h1>
    <p class="lead">{lead}</p>
    <div class="cta-row">
      {ctaPrimary && (
        ctaPrimary.href === '/contact/' ? (
          <a href="/contact/" class="btn btn--primary btn--lg" data-modal-open>{ctaPrimary.label}</a>
        ) : (
          <a href={ctaPrimary.href} class="btn btn--primary btn--lg">{ctaPrimary.label}</a>
        )
      )}
      {ctaSecondary && <a href={ctaSecondary.href} class="btn btn--hero-ghost btn--lg">{ctaSecondary.label}</a>}
    </div>
    {trust && (
      <div class="trust-line">
        {trust.map((t) => (<span><b>{t.split(' ')[0]}</b> {t.split(' ').slice(1).join(' ')}</span>))}
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 560px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--navy);
  }
  .hero-bg { position: absolute; inset: 0; }
  .hero-bg img { width: 100%; height: 100%; object-fit: cover; }
  .hero-bg-fallback {
    width: 100%; height: 100%;
    background: linear-gradient(135deg, #12263a 0%, #1d3a58 55%, #28537a 100%);
  }
  .hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(9, 20, 32, 0.62) 0%, rgba(9, 20, 32, 0.38) 40%, rgba(9, 20, 32, 0.42) 70%, rgba(9, 20, 32, 0.66) 100%);
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 940px;
    margin: 0 auto;
    padding: 140px 24px;
    color: #fff;
  }
  .hero .eyebrow {
    color: #ffd9c2;
    background: rgba(232, 89, 12, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.22);
    padding: 7px 16px;
    border-radius: 999px;
    margin-bottom: 20px;
  }
  .hero h1 { color: #fff; margin: 0 0 22px; text-shadow: 0 2px 18px rgba(6, 14, 22, 0.45); }
  .hero .lead {
    margin: 0 auto;
    max-width: 740px;
    font-size: 1.15rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.94);
    text-shadow: 0 1px 10px rgba(6, 14, 22, 0.4);
  }
  .hero .cta-row { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; margin-top: 36px; }
  .hero .trust-line {
    margin-top: 30px;
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.88);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 22px;
  }
  .hero .trust-line b { color: #fff; }

  /* 深色 banner 上的次按钮变体 */
  .btn--hero-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 16px 34px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 1.02rem;
    line-height: 1.2;
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.55);
    cursor: pointer;
    transition: all 0.18s ease;
    white-space: nowrap;
  }
  .btn--hero-ghost:hover { background: #fff; color: var(--ink); border-color: #fff; }

  @media (max-width: 1000px) {
    .hero { min-height: 480px; }
    .hero-inner { padding: 110px 24px; }
  }
  @media (max-width: 640px) {
    .hero { min-height: 420px; }
    .hero-inner { padding: 90px 20px; }
    .hero .lead { font-size: 1.02rem; }
  }
</style>
