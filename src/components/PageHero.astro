---
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  lead2?: string;
  img?: string;
  imgAlt?: string;
  ctaPrimary?: { label: string; href: string };
  ctaSecondary?: { label: string; href: string };
  trust?: string[];
  stats?: { value: string; label: string }[];
}
const { eyebrow, title, lead, lead2, img, imgAlt, ctaPrimary, ctaSecondary, trust, stats } = Astro.props;
---

<section class={'hero' + (stats && stats.length ? ' hero--stats' : '')}>
  <div class="hero-bg">
    {img ? (
      <picture>
        <source media="(max-width: 768px)" srcset={img.replace('.webp', '-mobile.webp')} type="image/webp" />
        <img src={img} alt={imgAlt || title} loading="eager" fetchpriority="high" decoding="async" width="1440" height="810" />
      </picture>
    ) : (
      <div class="hero-bg-fallback" aria-hidden="true"></div>
    )}
    <div class="hero-overlay" aria-hidden="true"></div>
  </div>
  <div class="container hero-inner">
    <span class="eyebrow">{eyebrow}</span>
    <h1>{title}</h1>
    <p class="lead">{lead}</p>
    {lead2 && <p class="lead lead--sub">{lead2}</p>}
    <div class="cta-row">
      {ctaPrimary && (
        ctaPrimary.href.endsWith('/contact/') ? (
          <a href={ctaPrimary.href} class="btn btn--primary btn--lg" data-modal-open>{ctaPrimary.label}</a>
        ) : (
          <a href={ctaPrimary.href} class="btn btn--primary btn--lg">{ctaPrimary.label}</a>
        )
      )}
      {ctaSecondary && <a href={ctaSecondary.href} class="btn btn--hero-ghost btn--lg">{ctaSecondary.label}</a>}
    </div>
    {trust && (
      <div class="trust-line">
        {trust.map((t) => (<span><b>{t.split(' ')[0]}</b> {t.split(' ').slice(1).join(' ')}</span>))}
      </div>
    )}
  </div>
  {stats && stats.length > 0 && (
    <div class="hero-stats" aria-label="Company facts">
      <div class="container hero-stats__inner">
        {stats.map((s) => (
          <div class="hero-stat">
            <div class="hero-stat-num">{s.value}</div>
            <div class="hero-stat-lab">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  )}
</section>

<style>
  .hero {
    position: relative;
    min-height: 560px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--navy);
  }
  .hero-bg { position: absolute; inset: 0; }
  .hero-bg img { width: 100%; height: 100%; object-fit: cover; }
  .hero-bg-fallback {
    width: 100%; height: 100%;
    background: linear-gradient(135deg, #12263a 0%, #1d3a58 55%, #28537a 100%);
  }
  .hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(9, 20, 32, 0.62) 0%, rgba(9, 20, 32, 0.38) 40%, rgba(9, 20, 32, 0.42) 70%, rgba(9, 20, 32, 0.66) 100%);
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 1020px;
    margin: 0 auto;
    padding: 150px 24px;
    color: #fff;
  }
  .hero .eyebrow {
    display: inline-block;
    width: fit-content;
    align-self: center;
    color: #ffd9c2;
    background: rgba(232, 89, 12, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.22);
    padding: 8px 18px;
    border-radius: 999px;
    margin: 0 auto 26px;
    letter-spacing: 0.06em;
  }
  .hero h1 { color: #fff; margin: 0 0 28px; line-height: 1.28; text-shadow: 0 2px 18px rgba(6, 14, 22, 0.45); }
  .hero .lead {
    margin: 0 auto;
    max-width: 780px;
    font-size: 1.15rem;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.94);
    text-shadow: 0 1px 10px rgba(6, 14, 22, 0.4);
  }
  .hero .lead--sub {
    margin: 10px auto 0;
    max-width: 720px;
    font-size: 1.02rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.82);
  }
  .hero .cta-row { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; margin-top: 44px; }
  .hero .trust-line {
    margin-top: 34px;
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.88);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 24px;
  }
  .hero .trust-line b { color: #fff; }

  /* 深色 banner 上的次按钮变体 */
  .btn--hero-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 16px 34px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 1.02rem;
    line-height: 1.2;
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.55);
    cursor: pointer;
    transition: all 0.18s ease;
    white-space: nowrap;
  }
  .btn--hero-ghost:hover { background: #fff; color: var(--ink); border-color: #fff; }

  /* 带实力数据条的 hero：固定紧凑高度，避免首页首屏过长 */
  .hero--stats {
    min-height: 680px;
    flex-direction: column;
    justify-content: flex-start;
  }
  .hero--stats .hero-inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 72px 24px 28px;
  }
  .hero--stats .hero-inner h1 { margin-bottom: 16px; }
  .hero--stats .hero-inner .cta-row { margin-top: 26px; }
  .hero-stats {
    position: relative;
    z-index: 1;
    width: 100%;
    background: rgba(6, 14, 22, 0.58);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(3px);
  }
  .hero-stats__inner {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 14px;
    padding: 32px 24px 36px;
  }
  .hero-stat { text-align: center; }
  .hero-stat-num {
    font-size: 2.45rem;
    font-weight: 800;
    color: #fff;
    line-height: 1.1;
    white-space: nowrap;
    text-shadow: 0 1px 8px rgba(6, 14, 22, 0.5);
  }
  .hero-stat-lab {
    font-size: 0.94rem;
    color: rgba(255, 255, 255, 0.84);
    margin-top: 8px;
    line-height: 1.35;
  }

  @media (max-width: 1000px) {
    .hero { min-height: 480px; }
    .hero-inner { padding: 110px 24px; }
    .hero--stats { min-height: 620px; }
    .hero--stats .hero-inner { padding: 64px 24px 28px; }
    .hero-stats__inner { grid-template-columns: repeat(3, 1fr); gap: 18px 10px; padding: 28px 16px 32px; }
    .hero-stat-num { font-size: 2rem; }
  }
  @media (max-width: 640px) {
    .hero { min-height: 420px; }
    .hero-inner { padding: 90px 20px; }
    .hero--stats { min-height: 560px; }
    .hero--stats .hero-inner { padding: 28px 20px 12px; }
    .hero--stats .hero-inner .eyebrow { margin-bottom: 12px; padding: 5px 12px; font-size: 0.8rem; }
    .hero--stats .hero-inner h1 { font-size: 1.45rem; line-height: 1.25; margin-bottom: 12px; }
    .hero--stats .hero-inner .lead { font-size: 0.9rem; line-height: 1.55; }
    .hero--stats .hero-inner .cta-row { gap: 10px; margin-top: 16px; flex-wrap: nowrap !important; }
    .hero--stats .hero-inner .btn { padding: 10px 16px; font-size: 0.88rem; }
    .hero .lead { font-size: 1.02rem; }
    .hero-stats__inner { grid-template-columns: repeat(3, 1fr); gap: 10px 6px; padding: 18px 10px 20px; }
    .hero-stat-num { font-size: 1.45rem; }
    .hero-stat-lab { font-size: 0.78rem; margin-top: 6px; }
  }
</style>
