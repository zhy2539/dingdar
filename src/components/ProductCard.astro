---
import OptImg from './OptImg.astro';

interface Props {
  code: string;
  name: string;
  img: string;
}
const { code, name, img } = Astro.props;
---

<div class="card card--hover prod-card">
  <div class="thumb">
    <OptImg
      src={img}
      alt={name + ' ' + code}
      width={640}
      height={480}
      sizes="(max-width: 640px) 46vw, (max-width: 1024px) 30vw, 300px"
    />
  </div>
  <div class="body">
    <span class="code">{code}</span>
    <h3>{name}</h3>
    <p>Produced to drawing, sample or part number.</p>
  </div>
</div>
