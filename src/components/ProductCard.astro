---
interface Props {
  code: string;
  name: string;
  img: string;
}
const { code, name, img } = Astro.props;
---

<div class="card card--hover prod-card">
  <div class="thumb">
    <picture>
      <source srcset={img.replace('.webp', '-640.webp')} type="image/webp" />
      <img src={img} alt={name + ' ' + code} loading="lazy" width="640" height="480" />
    </picture>
  </div>
  <div class="body">
    <span class="code">{code}</span>
    <h3>{name}</h3>
    <p>Produced to drawing, sample or part number.</p>
  </div>
</div>
