---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ModalContact from '../components/ModalContact.astro';
import { SITE } from '../data/config';
import { HTML_LANGS, OG_LOCALES, hreflangUrls, langPath, type AnyLang } from '../i18n';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: object | object[];
  path?: string;
  // 多语言：lang 为当前页面语言（默认 en）；enPath 为该页面的英文路径（用于 hreflang）
  lang?: AnyLang;
  enPath?: string;
  /** Limit alternate links to translations that contain real page content. */
  alternateLangs?: AnyLang[];
  preloadImages?: string[];
}

const { title, description, image, noindex, jsonLd, path, lang = 'en', enPath = path || '/', alternateLangs, preloadImages = [] } = Astro.props;
const seoDescription = description.length > 155
  ? description.slice(0, 152).replace(/\s+\S*$/, '') + '...'
  : description;
const canonical = lang === 'en' ? (path ? `${SITE.domain}${path}` : Astro.url.origin + Astro.url.pathname) : `${SITE.domain}${langPath(lang as AnyLang, enPath)}`;
const ogImage = image ? `${SITE.domain}${image}` : `${SITE.domain}/images/og-default.webp`;
const htmlLang = HTML_LANGS[lang];
const ogLocale = OG_LOCALES[lang];
const hreflang = hreflangUrls(enPath).filter((item) => !alternateLangs || alternateLangs.includes(item.code));
const defaultAlternate = hreflang.find((item) => item.code === 'en') || hreflang[0];

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.domain}/#organization`,
  name: 'DINGDAR Casting',
  legalName: SITE.legalName,
  url: SITE.domain,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE.domain}/images/logo.png`,
  },
  image: `${SITE.domain}/images/og-default.webp`,
  sameAs: [
    'https://www.youtube.com/@DINGDAR-Group',
    'https://www.tiktok.com/@hn_dingdar',
  ],
  email: SITE.email,
  telephone: SITE.whatsappTel,
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    email: SITE.email,
    telephone: SITE.whatsappTel,
  },
  address: {
    '@type': 'PostalAddress',
    addressRegion: 'Henan',
    addressCountry: 'CN',
  },
  foundingDate: '1986',
  slogan: SITE.tagline,
  description: SITE.description,
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.domain}/#website`,
  url: `${SITE.domain}/`,
  name: 'DINGDAR Casting',
  publisher: { '@id': `${SITE.domain}/#organization` },
  inLanguage: ['en', 'es', 'fr', 'pt', 'ru'],
};

const jsonLdItems = (Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []) as object[];
const hasBreadcrumbLd = jsonLdItems.some((item) => {
  if (!item || typeof item !== 'object') return false;
  return (item as Record<string, unknown>)['@type'] === 'BreadcrumbList';
});
const breadcrumbPath = path || Astro.url.pathname;
const breadcrumbSegments = breadcrumbPath.split('/').filter(Boolean);
const breadcrumbNames: Record<string, string> = {
  es: 'Español', fr: 'Français', ru: 'Русский', pt: 'Português',
  products: 'Products', processes: 'Processes', news: 'News', about: 'About',
  contact: 'Contact', faq: 'FAQ', privacy: 'Privacy', 'request-sample': 'Request Sample',
  'green-sand': 'Green Sand Casting', 'shell-moulding': 'Shell Moulding',
  'lost-foam': 'Lost Foam Casting', investment: 'Investment Casting',
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${SITE.domain}${breadcrumbPath}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.domain + '/' },
    ...breadcrumbSegments.map((segment, index) => ({
      '@type': 'ListItem',
      position: index + 2,
      name: breadcrumbNames[segment] || segment.replace(/[-_]/g, ' '),
      item: SITE.domain + '/' + breadcrumbSegments.slice(0, index + 1).join('/') + '/',
    })),
  ],
};
const ld = noindex ? [] : [orgLd, websiteLd, ...(hasBreadcrumbLd ? [] : [breadcrumbLd]), ...jsonLdItems];
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={seoDescription} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/images/logo.png" />

    {hreflang && (
      <>
        {hreflang.map((h) => (
          <link rel="alternate" hreflang={h.code} href={SITE.domain + h.url} />
        ))}
        {defaultAlternate && <link rel="alternate" hreflang="x-default" href={SITE.domain + defaultAlternate.url} />}
      </>
    )}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DINGDAR Casting" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={ogLocale} />
    {hreflang && hreflang.map((h) => h.code !== lang && <meta property="og:locale:alternate" content={OG_LOCALES[h.code]} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Merriweather:wght@400;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Merriweather:wght@400;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Merriweather:wght@400;700&display=swap"
      />
    </noscript>

    {preloadImages.map((p) => (
      p.endsWith('.webp') ? (
        <>
          <link rel="preload" as="image" href={p.replace('.webp', '-mobile.webp')} media="(max-width: 768px)" fetchpriority="high" />
          <link rel="preload" as="image" href={p} media="(min-width: 769px)" fetchpriority="high" />
        </>
      ) : (
        <link rel="preload" as="image" href={p} fetchpriority="high" />
      )
    ))}

    {ld.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}

    <!-- 仅正式域名采集，避免本地预览与 Pages 预览流量污染 Clarity -->
    <script is:inline>
      if (window.location.hostname === 'dingdar.com' || window.location.hostname === 'www.dingdar.com') {
        (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "z54r1ikemg");
      }
    </script>

    {SITE.gaId && (
      <script is:inline set:html={`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
window.dingdarTrackEvent = function (name, params) {
   return new Promise(function (resolve) {
     var done = false;
     var finish = function () { if (!done) { done = true; resolve(); } };
     window.setTimeout(finish, 1000);
     var payload = { event_callback: finish, event_timeout: 900 };
     if (params) { for (var k in params) { if (Object.prototype.hasOwnProperty.call(params, k)) payload[k] = params[k]; } }
     try { gtag('event', name, payload); }
     catch (_) { finish(); }
   });
 };
if (location.hostname === 'dingdar.com' || location.hostname === 'www.dingdar.com') {
  window.addEventListener('load', function () {
    window.setTimeout(function () {
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=${SITE.gaId}';
      document.head.appendChild(s);
      gtag('js', new Date());
      gtag('config', '${SITE.gaId}');
    }, 1200);
  });
}`} />
    )}
  </head>
  <body>
    <Header lang={lang} enPath={enPath} alternateLangs={alternateLangs} />
    <main><slot /></main>
    <Footer lang={lang} enPath={enPath} />
    <ModalContact lang={lang} />

    <a
      href={'https://wa.me/' + SITE.whatsappTel + '?text=' + encodeURIComponent(SITE.waText)}
      class="wa-float"
      target="_blank"
      rel="noopener"
      data-wa-float
      aria-label="Chat with DINGDAR on WhatsApp"
    >
      <svg class="wa-ico" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
        <path d="M16.04 2C8.53 2 2.4 8.13 2.4 15.64c0 2.4.63 4.74 1.83 6.8L2.32 30l7.76-1.83a13.6 13.6 0 0 0 5.95 1.37h.01c7.5 0 13.63-6.13 13.63-13.64C29.68 8.13 23.55 2 16.04 2Zm0 24.98c-2.2 0-4.36-.59-6.23-1.7l-.45-.26-4.6 1.08 1.22-4.48-.3-.47a11.3 11.3 0 0 1-1.74-6.02c0-6.24 5.08-11.32 11.34-11.32 3.03 0 5.88 1.18 8.02 3.32a11.3 11.3 0 0 1 3.32 8.04c0 6.24-5.1 11.31-11.57 11.31Zm6.22-8.48c-.34-.17-2.02-1-2.34-1.11-.31-.11-.54-.17-.77.17-.23.34-.88 1.1-1.08 1.33-.2.23-.4.26-.74.09-.34-.17-1.44-.53-2.74-1.69-1.01-.9-1.7-2.02-1.9-2.36-.2-.34-.02-.52.15-.69.15-.15.34-.4.5-.6.17-.2.23-.34.34-.57.11-.23.06-.43-.03-.6-.09-.17-.77-1.85-1.05-2.53-.28-.68-.56-.58-.77-.6h-.66c-.23 0-.6.09-.91.43-.31.34-1.2 1.17-1.2 2.85s1.23 3.3 1.4 3.53c.17.23 2.42 3.7 5.87 5.19.82.36 1.46.57 1.96.73.82.26 1.57.22 2.16.13.66-.1 2.02-.82 2.3-1.62.28-.8.28-1.48.2-1.62-.09-.14-.31-.23-.65-.4Z"/>
      </svg>
      <span class="wa-txt">WhatsApp Us</span>
    </a>

    <script is:inline>
      // 交互埋点：WhatsApp / 电话 / 邮箱 / 开始填表
      // 全部用事件委托，不依赖各页面自己的脚本，新增页面也会自动生效
      (function () {
        function track(name, params) {
          if (window.dingdarTrackEvent) { window.dingdarTrackEvent(name, params); return; }
          try { gtag('event', name, params || {}); } catch (_) {}
        }

        document.addEventListener('click', function (e) {
          var el = e.target && e.target.closest ? e.target : null;
          if (!el) return;

          // WhatsApp：悬浮按钮或任意 wa.me 链接
          if (el.closest('[data-wa-float], a[href*="wa.me"]')) {
            track('whatsapp_click');
            return;
          }
          // 电话 / 邮箱
          var link = el.closest('a[href^="tel:"], a[href^="mailto:"]');
          if (link) {
            var href = link.getAttribute('href') || '';
            track(href.indexOf('tel:') === 0 ? 'tel_click' : 'email_click');
          }
        }, true);

        // 一开始填写询盘表单就算一次 form_start（同一表单每页只记一次）
        document.addEventListener('focusin', function (e) {
          var el = e.target;
          if (!el || !el.closest) return;
          var form = el.closest('form');
          if (!form) return;
           var action = form.getAttribute('action') || '';
           var formType = form.dataset.formType || (action.indexOf('/api/inquiry') !== -1 ? 'quote' : 'other');
           if (form.dataset.gaStarted === '1') return;
           form.dataset.gaStarted = '1';
           track('form_start', { form_type: formType, page_language: document.documentElement.lang || 'en' });

        }, true);
      })();
    </script>

    <!-- 首次来源归因：只保存 UTM 与 referrer，不保存姓名、邮箱等个人信息 -->
    <script is:inline>
      (function () {
        try {
          var params = new URLSearchParams(window.location.search);
          var keys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
          var current = {};
          keys.forEach(function (key) { var value = params.get(key); if (value) current[key] = value.slice(0, 200); });
          if (document.referrer) current.referrer = document.referrer.slice(0, 500);
          var existing = JSON.parse(sessionStorage.getItem('dingdar_attribution') || '{}');
          if (!existing.first_page) current.first_page = window.location.href.slice(0, 500);
          var merged = Object.assign({}, current, existing);
          if (!existing.first_page) merged.first_page = window.location.href.slice(0, 500);
          sessionStorage.setItem('dingdar_attribution', JSON.stringify(merged));
        } catch (_) {}
      })();
    </script>

    <!-- Cloudflare Turnstile：显式渲染，隐藏弹窗内的控件延后到打开时再渲染 -->
    <script is:inline>
      window.ddTsRender = function (el) {
        if (!el || el.dataset.tsRendered === '1' || !window.turnstile) return;
        try {
          var id = window.turnstile.render(el, {
            sitekey: el.dataset.sitekey,
            theme: 'light',
            size: 'normal',
          });
          el.dataset.tsRendered = '1';
          el.dataset.tsId = id;
        } catch (err) {}
      };
      window.ddTsReset = function (root) {
        var el = (root || document).querySelector('[data-turnstile]');
        if (!el || !window.turnstile) return;
        if (el.dataset.tsId) {
          try { window.turnstile.reset(el.dataset.tsId); } catch (err) {}
        }
      };
      window.ddTsOnload = function () {
        window.__ddTsReady = true;
        var list = document.querySelectorAll('[data-turnstile]');
        for (var i = 0; i < list.length; i++) {
          // 弹窗在关闭状态是 display:none，控件放进去会渲染成空白，等打开时再渲染
          if (list[i].closest('.mc-modal')) continue;
          window.ddTsRender(list[i]);
        }
      };

      // 提交前本地校验：控件没通过就明确提示，而不是让用户看到"出错了"
      document.addEventListener(
        'submit',
        function (e) {
          var form = e.target;
          if (!form || !form.querySelector) return;
          var widget = form.querySelector('[data-turnstile]');
          if (!widget) return;
          var token = form.querySelector('input[name="cf-turnstile-response"]');
          if (token && token.value) return;
          e.preventDefault();
          e.stopImmediatePropagation();
          var hint =
            form.dataset.hintCaptcha ||
            'Please tick the security check just above the button, then submit again.';
          var box = form.querySelector('#form-status, [data-mc-status], .hint');
          if (box) {
            box.textContent = hint;
            box.style.color = '#d9480f';
          }
        },
        true
      );
    </script>
    <script
      is:inline
      src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=ddTsOnload"
      async
      defer></script>
  </body>
</html>
