---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { CAPABILITY_STATS, COMPLIANCE, OEM_STEPS, OEM_CUSTOMIZABLE, SITE } from '../../data/config';
import { dicts, LANG_CODES, getT, langPath, type Lang } from '../../i18n';

export function getStaticPaths() {
  return LANG_CODES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = getT(lang as Lang);
const ab = (key: string) => t('ab.' + key);
const rs = (key: string) => t('rs.' + key);
const ct = (key: string) => t('ct.' + key);
const common = (key: string) => t('common.' + key);
const langHref = (enPath: string) => langPath(lang as Lang, enPath);

const routes = [ab('r0'), ab('r1'), ab('r2'), ab('r3')];
const facts = [ab('facts0'), ab('facts1'), ab('facts2')];
const moqRows = [0, 1, 2].map((i) => ({ scale: ab('mr' + i + '.scale'), typical: ab('mr' + i + '.typical'), confirmed: ab('mr' + i + '.confirmed') }));
const capCards = CAPABILITY_STATS.map((s, i) => ({ value: s.value, label: ab('cap' + i) }));
const dlFields = [
  { name: 'name', label: ct('f0.label'), type: 'text', required: true, placeholder: ct('f0.placeholder') },
  { name: 'email', label: ct('f1.label'), type: 'email', required: true, placeholder: ct('f1.placeholder') },
  { name: 'company', label: ct('f2.label'), type: 'text', required: true, placeholder: ct('f2.placeholder') },
  { name: 'country', label: ct('f3.label'), type: 'text', required: false, placeholder: ct('f3.placeholder') },
];
const inside = ['rs.in0', 'rs.in1', 'rs.in2', 'rs.in3', 'rs.in4'].map((k) => t(k));
---

<BaseLayout
  title={t('meta.about.title')}
  description={t('meta.about.desc')}
  path={langPath(lang as Lang, '/about/')}
  lang={lang}
  enPath="/about/"
>
  <PageHero
    eyebrow={ab('heroEyebrow')}
    title={ab('heroTitle')}
    lead={ab('heroLead')}
    img="/images/factory-casting-workshop.webp"
    imgAlt="Molten metal pouring in the DINGDAR foundry"
    ctaPrimary={{ label: common('contactUs'), href: langHref('/contact/') }}
  />

  <section class="section">
    <div class="container">
      <div class="grid grid--2" style="align-items:center;">
        <div>
          <span class="eyebrow">{ab('whoEyebrow')}</span>
          <h2>{ab('whoH2')}</h2>
          <p style="margin-top:16px;">{ab('whoPara')}</p>
          <ul style="margin-top:18px;">
            {facts.map((f) => (
              <li style="padding:8px 0;border-top:1px solid var(--bg-tint);display:flex;gap:10px;font-size:0.95rem;">
                <span style="color:var(--accent);font-weight:800;">✓</span>{f}
              </li>
            ))}
          </ul>
        </div>
        <div class="grid grid--3">
          {capCards.map((s) => (
            <div class="card" style="padding:28px 12px;text-align:center;">
              <div style="font-size:1.65rem;font-weight:800;color:var(--ink);white-space:nowrap;">{s.value}</div>
              <div style="font-size:0.88rem;color:var(--muted);margin-top:6px;">{s.label}</div>
            </div>
          ))}
          <div class="card" style="padding:28px 12px;text-align:center;">
            <div style="font-size:1.65rem;font-weight:800;color:var(--ink);white-space:nowrap;">12–24h</div>
            <div style="font-size:0.88rem;color:var(--muted);margin-top:6px;">{ab('cap4')}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="sec-head center">
        <span class="eyebrow">{ab('routesEyebrow')}</span>
        <h2>{ab('routesH2')}</h2>
      </div>
      <div class="grid grid--4">
        {routes.map((r) => (
          <div class="card" style="padding:22px 24px;text-align:center;"><h3 style="font-size:1.02rem;">{r}</h3></div>
        ))}
      </div>
      <div class="grid grid--3" style="margin-top:40px;">
        <div class="card" style="overflow:hidden;">
          <img src="/images/foundry-pouring.webp" alt="Casting pouring operation" loading="lazy" width="900" height="450" style="width:100%;height:220px;object-fit:cover;" />
          <div style="padding:20px 22px;"><h3 style="font-size:1.02rem;">{ab('cc0.title')}</h3><p style="font-size:0.9rem;color:var(--muted);margin-top:6px;">{ab('cc0.text')}</p></div>
        </div>
        <div class="card" style="overflow:hidden;">
          <img src="/images/factory-machined-parts.webp" alt="Machined casting parts" loading="lazy" width="900" height="450" style="width:100%;height:220px;object-fit:cover;" />
          <div style="padding:20px 22px;"><h3 style="font-size:1.02rem;">{ab('cc1.title')}</h3><p style="font-size:0.9rem;color:var(--muted);margin-top:6px;">{ab('cc1.text')}</p></div>
        </div>
        <div class="card" style="overflow:hidden;">
          <img src="/images/quality-inspection.webp" alt="Quality inspection" loading="lazy" width="900" height="450" style="width:100%;height:220px;object-fit:cover;" />
          <div style="padding:20px 22px;"><h3 style="font-size:1.02rem;">{ab('cc2.title')}</h3><p style="font-size:0.9rem;color:var(--muted);margin-top:6px;">{ab('cc2.text')}</p></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--soft" id="oem">
    <div class="container">
      <div class="sec-head center">
        <span class="eyebrow">{ab('oemEyebrow')}</span>
        <h2>{ab('oemH2')}</h2>
        <p>{ab('oemP')}</p>
      </div>
      <div class="steps">
        {OEM_STEPS.map((s, i) => (
          <div class="step">
            <span class="n">{s.step}</span>
            <h3>{ab('st' + i + '.name')}</h3>
            <p style="font-size:0.85rem;color:var(--accent);font-weight:600;">{ab('st' + i + '.time')}</p>
            <p style="font-size:0.9rem;color:var(--muted);margin-top:4px;">{ab('st' + i + '.desc')}</p>
          </div>
        ))}
      </div>
      <div class="table-wrap" style="margin-top:40px;">
        <table>
          <thead>
            <tr><th>{ab('moqH0')}</th><th>{ab('moqH1')}</th><th>{ab('moqH2')}</th></tr>
          </thead>
          <tbody>
            {moqRows.map((r) => (
              <tr><td>{r.scale}</td><td>{r.typical}</td><td>{r.confirmed}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p style="font-size:0.85rem;color:var(--muted);margin-top:12px;">{ab('moqNote')}</p>
      <div class="sec-head" style="margin-top:44px;">
        <span class="eyebrow">{ab('custEyebrow')}</span>
        <h2>{ab('custH2')}</h2>
      </div>
      <div class="grid grid--3">
        {OEM_CUSTOMIZABLE.map((x, i) => (
          <div class="card" style="padding:22px 24px;text-align:center;">
            <h3 style="font-size:1rem;">{ab('co' + i)}</h3>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="compliance">
    <div class="container">
      <div class="sec-head">
        <span class="eyebrow">{ab('matEyebrow')}</span>
        <h2>{ab('matH2')}</h2>
        <p>{ab('matP')}</p>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>{ab('mth0')}</th><th>{ab('mth1')}</th><th>{ab('mth2')}</th><th>{ab('mth3')}</th></tr>
          </thead>
          <tbody>
            {COMPLIANCE.materials.map((m, i) => (
              <tr>
                <td style="font-weight:700;color:var(--ink);background:var(--bg-tint);">{ab('am' + i + '.name')}</td>
                <td>{ab('am' + i + '.grades')}</td>
                <td>{ab('am' + i + '.detail')}</td>
                <td>{ab('am' + i + '.standard')}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p style="font-size:0.84rem;color:var(--muted);margin-top:10px;">{ab('matNote')}</p>
        <p style="font-size:0.9rem;margin-top:14px;">
          <span style="font-weight:700;color:var(--ink);">{ab('refLabel')} </span>
          {COMPLIANCE.refs.map((r, i) => (
            <span>{i > 0 && ' · '}<a href={r.url} target="_blank" rel="noopener nofollow" style="color:var(--accent);font-weight:600;">{r.name}</a></span>
          ))}
        </p>
      </div>

      <div class="sec-head" style="margin-top:44px;">
        <span class="eyebrow">{ab('inspEyebrow')}</span>
        <h2>{ab('inspH2')}</h2>
        <p>{ab('inspP')}</p>
      </div>
      <div class="grid grid--3">
        {COMPLIANCE.inspection.map((x, i) => (
          <div class="card" style="padding:22px 24px;">
            <h3 style="font-size:1rem;color:var(--accent);">✓ {ab('insp' + i)}</h3>
          </div>
        ))}
      </div>

      <div class="card" style="padding:34px 34px;max-width:860px;margin:40px auto 0;">
        <h2 style="font-size:1.35rem;margin-bottom:14px;">{ab('certTitle')}</h2>
        <p style="font-size:0.97rem;line-height:1.75;color:var(--ink-2);">{ab('certP')}</p>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="sec-head">
        <span class="eyebrow">{ab('verifyEyebrow')}</span>
        <h2>{ab('verifyH2')}</h2>
        <p>{ab('verifyP')}</p>
      </div>
      <div class="grid grid--4" style="grid-template-columns:repeat(auto-fit,minmax(240px,1fr));">
        {COMPLIANCE.verify.map((v, i) => (
          <div class="card" style="padding:22px 24px;">
            <span class="eyebrow" style="font-size:0.72rem;letter-spacing:0.08em;">{ab('v' + i + '.k')}</span>
            <p style="font-size:0.98rem;margin-top:10px;line-height:1.6;">{ab('v' + i + '.v')}</p>
          </div>
        ))}
      </div>

      <div class="card" style="padding:26px 28px;margin-top:22px;max-width:860px;">
        <h3 style="font-size:1.05rem;margin-bottom:12px;">{ab('vLinkTitle')}</h3>
        <ul style="list-style:none;padding:0;margin:0;">
          {COMPLIANCE.verifyLinks.map((l, i) => (
            <li style="padding:10px 0;border-top:1px solid var(--bg-tint);">
              <a href={l.url} target="_blank" rel="noopener" style="font-weight:700;color:var(--accent);">{ab('l' + i + '.label')} →</a>
              <p style="font-size:0.86rem;color:var(--muted);margin-top:3px;">{ab('l' + i + '.note')}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--soft" id="company-profile">
    <div class="container">
      <div class="sec-head center">
        <span class="eyebrow">{rs('heroEyebrow')}</span>
        <h2>{rs('heroTitle')}</h2>
        <p>{rs('heroLead')}</p>
      </div>
      <div class="grid grid--2" style="grid-template-columns:1.1fr 0.9fr;gap:40px;align-items:start;">
        <div class="card" id="download-form" style="padding:34px 32px;">
          <h3 style="font-size:1.5rem;">{rs('formTitle')}</h3>
          <p style="font-size:0.95rem;color:var(--muted);margin:10px 0 24px;">{rs('formNote')}</p>

          <form id="dl" action={SITE.formEndpoint} method="POST" novalidate data-err-required={rs('errRequired')} data-err-email={rs('errEmail')}>
            <div class="hp-field" aria-hidden="true">
              <label>Leave this field empty</label>
              <input type="text" name="_honey" tabindex="-1" autocomplete="off" />
            </div>
            <input type="hidden" name="_subject" value="Company profile download request from dingdar.com" />

            <div class="grid grid--2" style="gap:16px;">
              {dlFields.map((f) => (
                <div class="field">
                  <label for={f.name}>{f.label}</label>
                  <input id={f.name} name={f.name} type={f.type} placeholder={f.placeholder} required={f.required} />
                </div>
              ))}
            </div>

            <div class="field" style="margin-top:6px;">
              <button type="submit" class="btn btn--primary btn--lg" style="width:100%;">{rs('getDownloadLink')}</button>
              <p class="hint" id="form-status" role="status" aria-live="polite"></p>
            </div>
          </form>

          <div id="dl-success" style="display:none;margin-top:26px;padding:24px;border:1px solid #d8e8d8;background:#f2faf2;border-radius:12px;text-align:center;">
            <h3 style="font-size:1.15rem;margin-bottom:10px;">{rs('sTitle')}</h3>
            <p style="font-size:0.93rem;color:var(--muted);margin-bottom:16px;">{rs('sText')}</p>
            <a href="/company-profile.pdf" class="btn btn--primary btn--lg" download>{rs('downloadBtn')}</a>
          </div>
        </div>

        <div>
          <div class="card" style="padding:30px 28px;margin-bottom:24px;">
            <h3 style="font-size:1.15rem;margin-bottom:16px;">{rs('insideTitle')}</h3>
            <ul>
              {inside.map((x) => (
                <li style="padding:8px 0;border-top:1px solid var(--bg-tint);display:flex;gap:10px;font-size:0.94rem;">
                  <span style="color:var(--accent);font-weight:800;">✓</span>{x}
                </li>
              ))}
            </ul>
          </div>

          <div class="card" style="padding:30px 28px;">
            <h3 style="font-size:1.15rem;margin-bottom:16px;">{rs('directTitle')}</h3>
            <ul class="contact-list">
              <li><span class="k">{common('whatsapp')}</span><a href={'https://wa.me/' + SITE.whatsappTel + '?text=' + encodeURIComponent(SITE.waText)}>{SITE.whatsapp}</a></li>
              <li><span class="k">{common('sales')}</span><a href={'mailto:' + SITE.email}>{SITE.email}</a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    title={ab('ctaTitle')}
    text={ab('ctaText')}
    cta={common('contactUs')}
  />
</BaseLayout>

<style>
  .contact-list li { display: flex; justify-content: space-between; gap: 16px; padding: 9px 0; border-top: 1px solid var(--bg-tint); font-size: 0.94rem; align-items: baseline; }
  .contact-list .k { color: var(--muted); font-size: 0.82rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; min-width: 96px; }
  .contact-list a { color: var(--ink); font-weight: 600; }
  .contact-list a:hover { color: var(--accent); }
  @media (max-width: 900px) { .grid--2[style] { grid-template-columns: 1fr !important; } }
</style>

<script>
  const form = document.getElementById('dl');
  const status = document.getElementById('form-status');
  const success = document.getElementById('dl-success');
  const endpoint = form.getAttribute('action') || '';
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    status.textContent = '';
    const data = new FormData(form);
    if (data.get('_honey')) return;
    const name = data.get('name')?.trim();
    const email = data.get('email')?.trim();
    if (!name || !email) {
      status.textContent = form.dataset.errRequired || 'Please complete your name and email.';
      status.style.color = '#d9480f';
      return;
    }
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
      status.textContent = form.dataset.errEmail || 'Please enter a valid email address.';
      status.style.color = '#d9480f';
      return;
    }
    if (!endpoint) {
      success.style.display = 'block';
      return;
    }
    try {
      const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      if (res.ok) {
        try { gtag('event', 'profile_downloaded'); } catch {}
        form.style.display = 'none';
        success.style.display = 'block';
      } else {
        status.textContent = 'Something went wrong. The download is still available below the form.';
        status.style.color = '#d9480f';
        success.style.display = 'block';
      }
    } catch {
      status.textContent = 'Network issue — the download link is shown below regardless.';
      status.style.color = '#d9480f';
      success.style.display = 'block';
    }
  });
</script>
