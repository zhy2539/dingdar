---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { NEWS, getNews } from '../../../data/news';
import { getCategory } from '../../../data/products';
import { dicts, LANG_CODES, getT, hasNewsTranslation, newsTranslationLangs, langPath, type Lang } from '../../../i18n';
import { marked } from 'marked';

export function getStaticPaths() {
  const out = [];
  for (const lang of LANG_CODES) {
    for (const [idx, n] of NEWS.entries()) {
      if (hasNewsTranslation(lang, idx, n.body.length)) {
        out.push({ params: { lang, slug: n.slug } });
      }
    }
  }
  return out;
}

const { lang, slug } = Astro.params;
const news = getNews(slug!);

if (!news) {
  return Astro.redirect(langPath(lang as Lang, '/news/'));
}

const idx = NEWS.findIndex((n) => n.slug === slug);
const t = getT(lang as Lang);
const article = (suffix: string) => t('nw.a' + idx + '.' + suffix);
const common = (key: string) => t('common.' + key);
const langHref = (enPath: string) => langPath(lang as Lang, enPath);
const title = article('title');
const excerpt = article('excerpt');
const body = [0, 1, 2, 3, 4, 5].map((i) => article('b' + i)).filter((x) => x);
const blocks = body.map((b) => marked.parse(b, { async: false, gfm: true }) as string);
const alternateLangs = newsTranslationLangs(idx, news.body.length);
const relatedProductSlugs: Record<number, string[]> = {
  0: ['jaw-crusher-wear-parts'],
  1: ['jaw-crusher-wear-parts'],
  2: ['jaw-crusher-wear-parts', 'cone-crusher-wear-parts', 'custom-castings'],
  3: ['custom-castings'],
  4: ['jaw-crusher-wear-parts'],
  5: ['custom-castings', 'jaw-crusher-wear-parts', 'cone-crusher-wear-parts', 'impact-crusher-wear-parts'],
  6: ['jaw-crusher-wear-parts', 'cone-crusher-wear-parts', 'impact-crusher-wear-parts'],
  7: ['jaw-crusher-wear-parts', 'cone-crusher-wear-parts', 'impact-crusher-wear-parts'],
  8: ['cone-crusher-wear-parts', 'jaw-crusher-wear-parts'],
  9: ['impact-crusher-wear-parts', 'hammer-crusher-wear-parts'],
  10: ['custom-castings'],
  11: ['jaw-crusher-wear-parts'],
};
const relatedProducts = (relatedProductSlugs[idx] || []).map((productSlug) => {
  const product = getCategory(productSlug)!;
  return {
    href: langHref('/products/' + productSlug + '/'),
    label: t('p.' + productSlug + '.cardTitle') || product.shortName,
  };
});
const ctaTitle = t('nw.ctaTitle');
const ctaText = t('nw.ctaText');
// 只链到确实有该语种译文的文章，否则会把用户送到英文页
const relatedPosts = (news.related ?? []).flatMap((s) => {
  const i = NEWS.findIndex((item) => item.slug === s);
  if (i < 0) return [];
  const item = NEWS[i];
  if (!hasNewsTranslation(lang as Lang, i, item.body.length)) return [];
  return [{ href: langHref('/news/' + item.slug + '/'), label: t('nw.a' + i + '.title') }];
});
---

<BaseLayout
  title={`${title}`}
  description={excerpt}
  path={langPath(lang as Lang, '/news/' + slug + '/')}
  image={news.cover.replace('.webp', '-og.webp')}
  lang={lang}
  enPath={'/news/' + slug + '/'}
  alternateLangs={alternateLangs}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    headline: title,
    datePublished: news.date,
    description: excerpt,
    image: 'https://dingdar.com' + news.cover,
    author: { '@type': 'Organization', name: 'DINGDAR Casting' },
    publisher: { '@type': 'Organization', name: 'Henan Dingdar Machinery Equipment Manufacture Co., Ltd.' },
  }}
>
  <section class="section" style="padding-top:64px;">
    <div class="container" style="max-width:860px;">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={langHref('/')}>{t('nav.0')}</a> / <a href={langHref('/news/')}>{t('nav.3')}</a> / <span>{title}</span>
      </nav>
      <span class="badge">{news.date}</span>
      <h1 style="margin-top:18px;margin-bottom:26px;">{title}</h1>
      <img src={news.cover} alt={title} width="1200" height="675" class="article-cover" />
      <div class="article-body">
        {blocks.map((p) => (<div class="blk" set:html={p}></div>))}
      </div>
      {relatedProducts.length > 0 && (
        <nav class="article-related" aria-label={common('browseProducts')}>
          <strong>{common('browseProducts')}:</strong>
          {relatedProducts.map((product) => <a href={product.href}>{product.label}</a>)}
          <a class="article-related__cta" href={langHref('/contact/')}>{common('getQuote')} →</a>
        </nav>
      )}
      {relatedPosts.length > 0 && (
        <nav class="article-related" aria-label={common('readMore')}>
          <strong>{common('readMore')}:</strong>
          {relatedPosts.map((post) => <a href={post.href}>{post.label}</a>)}
        </nav>
      )}
      <a href={langHref('/news/')} class="btn btn--ghost" style="margin-top:12px;">← {common('backToNews')}</a>
    </div>
  </section>

  <CtaBand
    title={ctaTitle}
    text={ctaText}
    cta={common('getQuote')}
  />
</BaseLayout>

<style>
  .article-body { margin-top: 32px; }
  .article-cover { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 14px; box-shadow: var(--shadow-md); }
  .article-body .blk { margin-bottom: 26px; font-size: 1.04rem; line-height: 1.8; color: var(--body); }
  .article-body p { margin-bottom: 20px; font-size: 1.04rem; line-height: 1.8; color: var(--body); }
  .article-body .blk > *:last-child { margin-bottom: 0; }
  .article-body ul, .article-body ol { margin: 0 0 22px 1.2em; padding: 0; }
  .article-body li { margin-bottom: 9px; font-size: 1.02rem; line-height: 1.75; color: var(--body); }
  .article-body h3 { margin: 30px 0 12px; font-size: 1.18rem; }
  .article-body table { width: 100%; border-collapse: collapse; margin: 6px 0 24px; font-size: 0.95rem; }
  .article-body th, .article-body td { padding: 10px 12px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
  .article-body th { background: var(--bg-tint); font-weight: 700; }

  .article-body a { color: var(--accent); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .article-related { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; margin: 32px 0 20px; padding: 20px 22px; border: 1px solid var(--line); border-radius: 14px; background: var(--bg-tint); }
  .article-related a { color: var(--accent); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .article-related__cta { margin-left: auto; }
  @media (max-width: 640px) { .article-related__cta { margin-left: 0; } }
</style>
