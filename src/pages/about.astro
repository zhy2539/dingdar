---
import OptImg from '../components/OptImg.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { CAPABILITY_STATS, COMPLIANCE, OEM_STEPS, OEM_CUSTOMIZABLE, SITE } from '../data/config';

const routes = [
  'Green sand casting',
  'Shell moulding',
  'Lost foam casting',
  'Investment casting',
];
const facts = [
  'Casting components, wear-resistant alloy castings and customized industrial components',
  'Casting, heat treatment, machining and inspection under one roof',
  'Engineering, manufacturing and project teams working on one requirement',
];
const moqRows = [
  { scale: 'Prototype / sample', typical: 'Single parts or small runs', confirmed: 'Tooling and quantity reviewed per project' },
  { scale: 'Small batch', typical: 'Trial quantities after sample approval', confirmed: 'Price per piece reviewed with tooling amortization' },
  { scale: 'Series / repeat orders', typical: 'Scheduled deliveries over the year', confirmed: 'Frame agreements with stable material and lead time' },
];
const dlFields = [
  { name: 'name', label: 'Your Name *', type: 'text', required: true, placeholder: 'Full name' },
  { name: 'email', label: 'Work Email *', type: 'email', required: true, placeholder: 'name@company.com' },
  { name: 'company', label: 'Company *', type: 'text', required: true, placeholder: 'Company name' },
  { name: 'country', label: 'Country', type: 'text', required: false, placeholder: 'Country / region' },
];
---

<BaseLayout
  title="About Us | Casting Manufacturer Since 1986 | DINGDAR"
  description="DINGDAR casting enterprise since 1986, with four in-house casting routes, machining and inspection for mining, quarrying and industrial components."
  path="/about/"
>
  <PageHero
    eyebrow="About DINGDAR"
    title="A Casting Enterprise Built Around the Process"
    lead="Castings and the machinery behind them, reviewed as one project — since 1986, from component sourcing to complete casting projects for foundries, OEM manufacturers, industrial buyers and distributors."
    img="/images/about-steel-mill.webp"
    imgAlt="Molten metal casting inside an industrial steel mill"
    ctaPrimary={{ label: 'Contact Us', href: '/contact/' }}
  />

  <section class="section">
    <div class="container">
      <div class="grid grid--2" style="align-items:center;">
        <div>
          <span class="eyebrow">Who we are</span>
          <h2>Henan Dingdar Machinery Equipment Manufacture Co., Ltd.</h2>
          <p style="margin-top:16px;">
            We supply general castings, wear-resistant alloy castings and customized industrial components, together with foundry equipment and process support. From casting components to complete production solutions, our engineering, manufacturing and project teams work together so industrial buyers manage specifications, production and delivery more efficiently.
          </p>
          <ul style="margin-top:18px;">
            {facts.map((f) => (
              <li style="padding:8px 0;border-top:1px solid var(--bg-tint);display:flex;gap:10px;font-size:0.95rem;">
                <span style="color:var(--accent);font-weight:800;">✓</span>{f}
              </li>
            ))}
          </ul>
        </div>
        <div class="grid grid--3">
          {CAPABILITY_STATS.map((s) => (
            <div class="card" style="padding:28px 12px;text-align:center;">
              <div style="font-size:1.65rem;font-weight:800;color:var(--ink);white-space:nowrap;">{s.value}</div>
              <div style="font-size:0.88rem;color:var(--muted);margin-top:6px;">{s.label}</div>
            </div>
          ))}
          <div class="card" style="padding:28px 12px;text-align:center;">
            <div style="font-size:1.65rem;font-weight:800;color:var(--ink);white-space:nowrap;">12–24h</div>
            <div style="font-size:0.88rem;color:var(--muted);margin-top:6px;">Technical feedback</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="sec-head center">
        <span class="eyebrow">Production</span>
        <h2>Four In-House Casting Routes</h2>
      </div>
      <div class="grid grid--4">
        {routes.map((r) => (
          <div class="card" style="padding:22px 24px;text-align:center;"><h3 style="font-size:1.02rem;">{r}</h3></div>
        ))}
      </div>
      <div class="grid grid--3" style="margin-top:40px;">
        <div class="card" style="overflow:hidden;">
          <OptImg src="/images/foundry-pouring.webp" alt="Casting pouring operation" width={900} height={450} sizes="(max-width: 768px) 92vw, 30vw" class="about-shot" />
          <div style="padding:20px 22px;"><h3 style="font-size:1.02rem;">Casting</h3><p style="font-size:0.9rem;color:var(--muted);margin-top:6px;">Process-matched production across four routes.</p></div>
        </div>
        <div class="card" style="overflow:hidden;">
          <OptImg src="/images/factory-machined-parts.webp" alt="Machined casting parts" width={900} height={450} sizes="(max-width: 768px) 92vw, 30vw" class="about-shot" />
          <div style="padding:20px 22px;"><h3 style="font-size:1.02rem;">Machining &amp; Heat Treatment</h3><p style="font-size:0.9rem;color:var(--muted);margin-top:6px;">Value-added finishing to the agreed scope.</p></div>
        </div>
        <div class="card" style="overflow:hidden;">
          <OptImg src="/images/quality-inspection.webp" alt="Quality inspection" width={900} height={450} sizes="(max-width: 768px) 92vw, 30vw" class="about-shot" />
          <div style="padding:20px 22px;"><h3 style="font-size:1.02rem;">Inspection &amp; Delivery</h3><p style="font-size:0.9rem;color:var(--muted);margin-top:6px;">Release evidence and export packing planned before production.</p></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--soft" id="oem">
    <div class="container">
      <div class="sec-head center">
        <span class="eyebrow">OEM &amp; custom casting</span>
        <h2>From Your Drawing to Released Castings</h2>
        <p>A drawing, sample or part number starts the review. Geometry, material grade, machining, inspection scope, MOQ and delivery are confirmed in writing before production.</p>
      </div>
      <div class="steps">
        {OEM_STEPS.map((s) => (
          <div class="step">
            <span class="n">{s.step}</span>
            <h3>{s.name}</h3>
            <p style="font-size:0.85rem;color:var(--accent);font-weight:600;">{s.time}</p>
            <p style="font-size:0.9rem;color:var(--muted);margin-top:4px;">{s.desc}</p>
          </div>
        ))}
      </div>
      <div class="table-wrap" style="margin-top:40px;">
        <table>
          <thead>
            <tr><th>Order scale</th><th>Typical</th><th>Confirmed during review</th></tr>
          </thead>
          <tbody>
            {moqRows.map((r) => (
              <tr><td>{r.scale}</td><td>{r.typical}</td><td>{r.confirmed}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p style="font-size:0.85rem;color:var(--muted);margin-top:12px;">Specific MOQ, tooling cost and lead time depend on geometry, material and quantity — send the part reference and we confirm these in writing.</p>
      <div class="sec-head" style="margin-top:44px;">
        <span class="eyebrow">What you can specify</span>
        <h2>Customizable Items</h2>
      </div>
      <div class="grid grid--3">
        {OEM_CUSTOMIZABLE.map((x) => (
          <div class="card" style="padding:22px 24px;text-align:center;">
            <h3 style="font-size:1rem;">{x}</h3>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="compliance">
    <div class="container">
      <div class="sec-head">
        <span class="eyebrow">Material standards</span>
        <h2>Grades We Cast and What They Mean for Your Part</h2>
        <p>Material families are selected against your working conditions during review — feed size, impact, abrasion and required hardness.</p>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Material family</th><th>Grades / series</th><th>Typical use</th><th>Common standard series</th></tr>
          </thead>
          <tbody>
            {COMPLIANCE.materials.map((m) => (
              <tr>
                <td style="font-weight:700;color:var(--ink);background:var(--bg-tint);">{m.name}</td>
                <td>{m.grades}</td>
                <td>{m.detail}</td>
                <td>{m.standard}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p style="font-size:0.84rem;color:var(--muted);margin-top:10px;">
          Standard series are shown as reference families; the exact standard, grade and acceptance criteria for your part are confirmed during the technical review.
        </p>
        <p style="font-size:0.9rem;margin-top:14px;">
          <span style="font-weight:700;color:var(--ink);">Independent references: </span>
          {COMPLIANCE.refs.map((r, i) => (
            <span>{i > 0 && ' · '}<a href={r.url} target="_blank" rel="noopener nofollow" style="color:var(--accent);font-weight:600;">{r.name}</a></span>
          ))}
        </p>
      </div>

      <div class="sec-head" style="margin-top:44px;">
        <span class="eyebrow">Inspection &amp; release evidence</span>
        <h2>What Ships With Your Order</h2>
        <p>Release evidence is agreed in the order — here is the scope we commonly provide.</p>
      </div>
      <div class="grid grid--3">
        {COMPLIANCE.inspection.map((x) => (
          <div class="card" style="padding:22px 24px;">
            <h3 style="font-size:1rem;color:var(--accent);">✓ {x}</h3>
          </div>
        ))}
      </div>

      <div class="card" style="padding:34px 34px;max-width:860px;margin:40px auto 0;">
        <h2 style="font-size:1.35rem;margin-bottom:14px;">A note on certificates</h2>
        <p style="font-size:0.97rem;line-height:1.75;color:var(--ink-2);">
          {COMPLIANCE.note} If your project requires ISO, material standards (such as ASTM, DIN or GB equivalents) or a specific inspection body, tell us during the review and we confirm what can be documented for that order.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="sec-head">
        <span class="eyebrow">Verifiable company facts</span>
        <h2>The Company Behind the Castings Can Be Verified</h2>
        <p>Before samples or mass production, confirm who you are dealing with through public channels and direct contact.</p>
      </div>
      <div class="grid grid--4" style="grid-template-columns:repeat(auto-fit,minmax(240px,1fr));">
        {COMPLIANCE.verify.map((v) => (
          <div class="card" style="padding:22px 24px;">
            <span class="eyebrow" style="font-size:0.72rem;letter-spacing:0.08em;">{v.k}</span>
            <p style="font-size:0.98rem;margin-top:10px;line-height:1.6;">{v.v}</p>
          </div>
        ))}
      </div>

      <div class="card" style="padding:26px 28px;margin-top:22px;max-width:860px;">
        <h3 style="font-size:1.05rem;margin-bottom:12px;">Verify it yourself</h3>
        <ul style="list-style:none;padding:0;margin:0;">
          {COMPLIANCE.verifyLinks.map((l) => (
            <li style="padding:10px 0;border-top:1px solid var(--bg-tint);">
              <a href={l.url} target="_blank" rel="noopener" style="font-weight:700;color:var(--accent);">{l.label} →</a>
              <p style="font-size:0.86rem;color:var(--muted);margin-top:3px;">{l.note}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section" id="exhibitions">
    <div class="container">
      <div class="sec-head">
        <span class="eyebrow">Exhibitions</span>
        <h2>Where We Exhibit — ANKIROS 2026, Istanbul</h2>
        <p>22–24 October 2026 · Istanbul Expo Center (ifm), Yeşilköy · Hall 4, stand E170</p>
      </div>

      <div class="expo-grid expo-grid--lead">
        <figure>
          <picture>
            <source
              type="image/webp"
              srcset="/images/ank2026-01-960.webp 960w, /images/ank2026-01-1440.webp 1440w"
              sizes="(max-width: 900px) 92vw, 1100px"
            />
            <img
              src="/images/ank2026-01.webp"
              alt="DINGDAR stand E170 in Hall 4 at ANKIROS 2026, Istanbul"
              width="1440"
              height="1080"
              loading="lazy"
              decoding="async"
            />
          </picture>
          <figcaption>Our stand in Hall 4, number E170 — ANKIROS 2026, Istanbul Expo Center.</figcaption>
        </figure>
      </div>

      <div class="expo-grid expo-grid--2">
        <figure>
          <OptImg
            src="/images/ank2026-03.webp"
            alt="DINGDAR booth panels at ANKIROS 2026 listing casting, forging, heat treatment and machining capability"
            width={960}
            height={720}
            sizes="(max-width: 760px) 92vw, 540px"
          />
          <figcaption>The capability panels: casting, forging, heat treatment, machining — the full route from raw material to finished component.</figcaption>
        </figure>
        <figure>
          <OptImg
            src="/images/ank2026-06.webp"
            alt="DINGDAR team at the ANKIROS 2026 fair entrance on 23 October 2026"
            width={960}
            height={720}
            sizes="(max-width: 760px) 92vw, 540px"
          />
          <figcaption>Day two at the fair, 23 October 2026.</figcaption>
        </figure>
      </div>

      <div class="expo-grid expo-grid--3">
        <figure>
          <OptImg
            src="/images/ank2026-05.webp"
            alt="DINGDAR team outside the Istanbul Expo Center during ANKIROS 2026"
            width={720}
            height={960}
            sizes="(max-width: 760px) 92vw, 350px"
          />
          <figcaption>The team at the Istanbul Expo Center.</figcaption>
        </figure>
        <figure>
          <OptImg
            src="/images/ank2026-04.webp"
            alt="ANKIROS 2026 banner at the Istanbul Expo Center entrance reading 22-24 October 2026"
            width={720}
            height={960}
            sizes="(max-width: 760px) 92vw, 350px"
          />
          <figcaption>ANKIROS 2026 ran 22–24 October.</figcaption>
        </figure>
        <figure>
          <OptImg
            src="/images/ank2026-02.webp"
            alt="DINGDAR display counter at the TEKAFOS stand during ANKIROS 2026"
            width={720}
            height={960}
            sizes="(max-width: 760px) 92vw, 350px"
          />
          <figcaption>DINGDAR display at the TEKAFOS stand.</figcaption>
        </figure>
      </div>

      <p style="font-size:1.02rem;line-height:1.85;color:var(--body);max-width:860px;margin-top:34px;">
        On the stand we carried the three lines we quote every week — crusher wear parts, ball mill liners,
        and large custom castings and forgings — alongside component examples from the panels: hollow shafts,
        ball valves, gears, large mining gear rings, rudder horns, mill end caps and mill refiner parts. If you
        visited and did not leave a drawing, the next step is the same as at the stand:
        <a href="/contact/" style="color:var(--accent);font-weight:600;">send the part number or a photo of the worn part</a>
        and the material and inspection scope come back in writing. See also
        <a href="/ball-mill-liners/" style="color:var(--accent);font-weight:600;">ball mill liners</a> and
        <a href="/quality/" style="color:var(--accent);font-weight:600;">quality and inspection records</a>.
      </p>
    </div>
  </section>

  <section class="section section--soft" id="company-profile">
    <div class="container">
      <div class="sec-head center">
        <span class="eyebrow">Supplier resources</span>
        <h2>Company Profile for Your Qualification File</h2>
        <p>One PDF with the facts your procurement team asks for: production capacity, product categories, materials, casting processes, inspection scope and contact channels.</p>
      </div>
      <div class="grid grid--2" style="grid-template-columns:1.1fr 0.9fr;gap:40px;align-items:start;">
        <div class="card" id="download-form" style="padding:34px 32px;">
          <h3 style="font-size:1.5rem;">Download the Company Profile</h3>
          <p style="font-size:0.95rem;color:var(--muted);margin:10px 0 24px;">Leave your details and the download link appears immediately. We may follow up with project-specific information when you are ready.</p>

          <form id="dl" action={SITE.formEndpoint} method="POST" novalidate>
            <div class="hp-field" aria-hidden="true">
              <label>Leave this field empty</label>
              <input type="text" name="_honey" tabindex="-1" autocomplete="off" />
            </div>
            <input type="hidden" name="_subject" value="Company profile download request from dingdar.com" />
            <input type="hidden" name="source_page" value="https://dingdar.com/about/#company-profile" />
            <input type="hidden" name="page_language" value="en" />

            <div class="grid grid--2" style="gap:16px;">
              {dlFields.map((f) => (
                <div class="field">
                  <label for={f.name}>{f.label}</label>
                  <input id={f.name} name={f.name} type={f.type} placeholder={f.placeholder} required={f.required} />
                </div>
              ))}
            </div>

            <div class="field" style="margin-top:6px;">
              <button type="submit" class="btn btn--primary btn--lg" style="width:100%;">Get the Download Link</button>
              <p class="hint" id="form-status" role="status" aria-live="polite"></p>
            </div>
          </form>

          <div id="dl-success" style="display:none;margin-top:26px;padding:24px;border:1px solid #d8e8d8;background:#f2faf2;border-radius:12px;text-align:center;">
            <h3 style="font-size:1.15rem;margin-bottom:10px;">Thank you — your download is ready</h3>
            <p style="font-size:0.93rem;color:var(--muted);margin-bottom:16px;">The company profile PDF is below. Need specific castings reviewed next? We reply to technical inquiries within 12–24 hours.</p>
            <a href="/company-profile.pdf" class="btn btn--primary btn--lg" download data-profile-download>Download Company Profile (PDF)</a>
          </div>
        </div>

        <div>
          <div class="card" style="padding:30px 28px;margin-bottom:24px;">
            <h3 style="font-size:1.15rem;margin-bottom:16px;">Inside the profile</h3>
            <ul>
              {[
                'Company overview & capacity (1986, 180,000 m², 720+ staff)',
                'Product categories & coverage',
                'Materials: Mn13/Mn18, Cr15–Cr26, alloy steel, ductile iron',
                'Casting processes & inspection scope',
                'OEM review path & contact channels',
              ].map((x) => (
                <li style="padding:8px 0;border-top:1px solid var(--bg-tint);display:flex;gap:10px;font-size:0.94rem;">
                  <span style="color:var(--accent);font-weight:800;">✓</span>{x}
                </li>
              ))}
            </ul>
          </div>

          <div class="card" style="padding:30px 28px;">
            <h3 style="font-size:1.15rem;margin-bottom:16px;">Prefer to talk first?</h3>
            <ul class="contact-list">
              <li><span class="k">WhatsApp</span><a href={'https://wa.me/' + SITE.whatsappTel + '?text=' + encodeURIComponent(SITE.waText)}>{SITE.whatsapp}</a></li>
              <li><span class="k">Sales</span><a href={'mailto:' + SITE.email}>{SITE.email}</a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    title="Work With a Casting Enterprise, Not a Price List"
    text="Send your requirement — drawing, sample or equipment model — and the project team will respond with technical feedback within 12–24 hours."
    cta="Contact Us"
  />
</BaseLayout>

<style>
  .contact-list li { display: flex; justify-content: space-between; gap: 16px; padding: 9px 0; border-top: 1px solid var(--bg-tint); font-size: 0.94rem; align-items: baseline; }
  .contact-list .k { color: var(--muted); font-size: 0.82rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; min-width: 96px; }
  .contact-list a { color: var(--ink); font-weight: 600; }
  .contact-list a:hover { color: var(--accent); }
  @media (max-width: 900px) { .grid--2[style] { grid-template-columns: 1fr !important; } }

  .expo-grid { display: grid; gap: 18px; margin-top: 22px; }
  .expo-grid--lead { grid-template-columns: 1fr; }
  .expo-grid--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .expo-grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .expo-grid figure { margin: 0; }
  .expo-grid img { display: block; width: 100%; height: auto; border-radius: 12px; background: var(--bg-tint); }
  .expo-grid figcaption { font-size: 0.84rem; color: var(--muted); margin-top: 9px; line-height: 1.55; }
  @media (max-width: 760px) {
    .expo-grid--2, .expo-grid--3 { grid-template-columns: 1fr; }
  }
</style>

<script>
  const form = document.getElementById('dl');
  const status = document.getElementById('form-status');
  const success = document.getElementById('dl-success');
  const endpoint = form.getAttribute('action') || '';
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    status.textContent = '';
    const data = new FormData(form);
    if (data.get('_honey')) return;
    const name = data.get('name')?.trim();
    const email = data.get('email')?.trim();
    if (!name || !email) {
      status.textContent = 'Please complete your name and email.';
      status.style.color = '#d9480f';
      return;
    }
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
      status.textContent = 'Please enter a valid email address.';
      status.style.color = '#d9480f';
      return;
    }
    if (!endpoint) {
      success.style.display = 'block';
      return;
    }
    try {
      const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      if (res.ok) {
        try { gtag('event', 'profile_requested'); } catch {}
        form.style.display = 'none';
        success.style.display = 'block';
      } else {
        status.textContent = 'Something went wrong. The download is still available below the form.';
        status.style.color = '#d9480f';
        success.style.display = 'block';
      }
    } catch {
      status.textContent = 'Network issue — the download link is shown below regardless.';
      status.style.color = '#d9480f';
      success.style.display = 'block';
    }
  });
  document.querySelector('[data-profile-download]')?.addEventListener('click', () => {
    try { gtag('event', 'profile_downloaded'); } catch {}
  });
</script>
