---
// 询盘后台。纯静态页 + 同源接口（/api/admin/*），不进 sitemap、不参与索引。
const title = '询盘后台 · DINGDAR';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <style>
      :root {
        --ink: #1a1d21;
        --body: #3f444b;
        --muted: #7b828c;
        --line: #e3e6ea;
        --bg: #f6f7f9;
        --accent: #c2410c;
        --new: #c2410c;
        --replied: #15803d;
        --archived: #64748b;
      }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif; background: var(--bg); color: var(--ink); }
      header { background: #fff; border-bottom: 1px solid var(--line); padding: 14px 20px; display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
      header h1 { font-size: 1.05rem; margin: 0; letter-spacing: 0.01em; }
      header .sp { margin-left: auto; }
      .wrap { max-width: 1180px; margin: 0 auto; padding: 22px 20px 60px; }
      .card { background: #fff; border: 1px solid var(--line); border-radius: 12px; }
      button, .btn { font: inherit; cursor: pointer; border-radius: 8px; border: 1px solid var(--line); background: #fff; padding: 7px 13px; color: var(--body); }
      button:hover { border-color: #c7ccd3; }
      .btn-primary { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 600; }
      .btn-primary:hover { background: #a33509; border-color: #a33509; }
      .btn-sm { padding: 4px 9px; font-size: 0.82rem; }
      input[type="password"], input[type="search"] { font: inherit; padding: 9px 12px; border: 1px solid var(--line); border-radius: 8px; width: 100%; }
      #login { max-width: 380px; margin: 12vh auto 0; padding: 26px; }
      #login h2 { margin: 0 0 6px; font-size: 1.1rem; }
      #login p { margin: 0 0 18px; color: var(--muted); font-size: 0.88rem; line-height: 1.6; }
      #login .row { display: flex; gap: 10px; margin-top: 14px; }
      .toolbar { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-bottom: 16px; }
      .tabs { display: flex; gap: 6px; flex-wrap: wrap; }
      .tabs button.on { background: var(--ink); border-color: var(--ink); color: #fff; }
      .tabs .n { opacity: 0.7; margin-left: 5px; font-size: 0.82em; }
      .search { flex: 1; min-width: 200px; max-width: 320px; }
      table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
      thead th { text-align: left; font-size: 0.74rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); padding: 11px 14px; border-bottom: 1px solid var(--line); white-space: nowrap; }
      tbody td { padding: 12px 14px; border-bottom: 1px solid var(--line); vertical-align: top; }
      tbody tr:last-child td { border-bottom: 0; }
      tbody tr:hover { background: #fbfcfd; }
      .who { font-weight: 600; }
      .sub { color: var(--muted); font-size: 0.82rem; margin-top: 2px; }
      .msg { color: var(--body); line-height: 1.65; max-width: 520px; }
      .msg.clamp { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
      .more { background: none; border: 0; color: var(--accent); padding: 0; font-size: 0.82rem; }
      .tag { display: inline-block; font-size: 0.74rem; font-weight: 700; padding: 2px 8px; border-radius: 999px; color: #fff; }
      .tag.new { background: var(--new); }
      .tag.replied { background: var(--replied); }
      .tag.archived { background: var(--archived); }
      .acts { display: flex; gap: 6px; flex-wrap: wrap; }
      .empty, .err { padding: 40px 20px; text-align: center; color: var(--muted); }
      .err { color: #b42318; }
      a { color: var(--accent); }
      @media (max-width: 820px) {
        thead { display: none; }
        tbody tr { display: block; border-bottom: 1px solid var(--line); padding: 12px 4px; }
        tbody td { display: block; border: 0; padding: 4px 10px; }
        tbody td::before { content: attr(data-l); display: block; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }
      }
    </style>
  </head>
  <body>
    <header>
      <h1>DINGDAR · 询盘后台</h1>
      <span class="sp"></span>
      <a class="btn" id="site-link" href="/" target="_blank" rel="noopener">打开网站</a>
      <button id="logout" hidden>退出</button>
    </header>

    <div class="wrap">
      <section id="login" class="card" hidden>
        <h2>登录</h2>
        <p>输入后台密码。密码在 Cloudflare Pages 的环境变量 <code>ADMIN_PASSWORD</code> 里设置。</p>
        <input id="pw" type="password" autocomplete="current-password" placeholder="后台密码" />
        <div class="row">
          <button class="btn-primary" id="do-login">登录</button>
          <span id="login-msg" class="sub"></span>
        </div>
      </section>

      <section id="panel" hidden>
        <div class="toolbar">
          <div class="tabs" id="tabs">
            <button data-status="new" class="on">待处理<span class="n" id="c-new">0</span></button>
            <button data-status="replied">已回复<span class="n" id="c-replied">0</span></button>
            <button data-status="archived">已归档<span class="n" id="c-archived">0</span></button>
            <button data-status="all">全部<span class="n" id="c-total">0</span></button>
          </div>
          <div class="search"><input id="q" type="search" placeholder="搜索姓名、邮箱、公司、内容…" /></div>
          <a class="btn" id="export" href="/api/admin/export" download>导出 CSV</a>
        </div>
        <div class="card" id="list"><div class="empty">加载中…</div></div>
      </section>

      <section id="boot" class="card"><div class="empty">加载中…</div></section>
    </div>

    <script is:inline>
      const $ = (s) => document.querySelector(s);
      let status = 'new';
      let timer = null;

      const fmt = (iso) => {
        if (!iso) return '';
        const d = new Date(iso);
        if (Number.isNaN(d.getTime())) return iso;
        const p = (n) => String(n).padStart(2, '0');
        return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}`;
      };

      const esc = (s) =>
        String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

      function show(view) {
        $('#boot').hidden = true;
        $('#login').hidden = view !== 'login';
        $('#panel').hidden = view !== 'panel';
        $('#logout').hidden = view !== 'panel';
      }

      async function load() {
        const q = $('#q').value.trim();
        const url = `/api/admin/inquiries?status=${encodeURIComponent(status)}&q=${encodeURIComponent(q)}`;
        const res = await fetch(url, { headers: { accept: 'application/json' } });
        if (res.status === 401) return show('login');
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          $('#list').innerHTML = `<div class="err">${esc(data.message || data.error || '读取失败')}</div>`;
          return;
        }
        const s = data.stats || {};
        $('#c-new').textContent = s.new ?? 0;
        $('#c-replied').textContent = s.replied ?? 0;
        $('#c-archived').textContent = s.archived ?? 0;
        $('#c-total').textContent = s.total ?? 0;
        $('#export').href = `/api/admin/export?status=${encodeURIComponent(status)}`;
        render(data.items || []);
      }

      function render(items) {
        if (!items.length) {
          $('#list').innerHTML = '<div class="empty">这个分类下暂无询盘。</div>';
          return;
        }
        const rows = items
          .map((it) => {
            const msg = esc(it.message || '');
            const long = (it.message || '').length > 180;
            const act = (s, label) =>
              it.status === s ? '' : `<button class="btn-sm" data-id="${it.id}" data-to="${s}">${label}</button>`;
            return `<tr>
              <td data-l="时间"><span class="sub">${esc(fmt(it.created_at))}</span></td>
              <td data-l="联系人">
                <div class="who">${esc(it.name || '（未填姓名）')}</div>
                <div class="sub"><a href="mailto:${esc(it.email)}">${esc(it.email)}</a></div>
                ${it.phone ? `<div class="sub">${esc(it.phone)}</div>` : ''}
              </td>
              <td data-l="公司 / 国家">
                <div>${esc(it.company || '—')}</div>
                <div class="sub">${esc(it.country || '')}</div>
              </td>
              <td data-l="内容">
                <div class="msg ${long ? 'clamp' : ''}" data-msg>${msg || '<span class="sub">（无正文）</span>'}</div>
                ${long ? '<button class="more" data-expand>展开</button>' : ''}
                ${it.source_page ? `<div class="sub">来源：${esc(it.source_page)}</div>` : ''}
              </td>
              <td data-l="状态"><span class="tag ${esc(it.status)}">${esc(it.status)}</span></td>
              <td data-l="操作"><div class="acts">
                ${act('replied', '标记已回复')}${act('archived', '归档')}${act('new', '重置为新')}
              </div></td>
            </tr>`;
          })
          .join('');
        $('#list').innerHTML = `<table><thead><tr>
          <th>时间</th><th>联系人</th><th>公司 / 国家</th><th>内容</th><th>状态</th><th>操作</th>
        </tr></thead><tbody>${rows}</tbody></table>`;
      }

      document.addEventListener('click', async (e) => {
        const t = e.target;
        if (t.dataset && t.dataset.expand !== undefined) {
          const m = t.parentElement.querySelector('[data-msg]');
          const on = m.classList.toggle('clamp') === false;
          t.textContent = on ? '收起' : '展开';
          return;
        }
        if (t.dataset && t.dataset.to) {
          t.disabled = true;
          await fetch('/api/admin/update', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ id: Number(t.dataset.id), status: t.dataset.to }),
          });
          load();
        }
      });

      $('#tabs').addEventListener('click', (e) => {
        const b = e.target.closest('button[data-status]');
        if (!b) return;
        status = b.dataset.status;
        for (const el of $('#tabs').querySelectorAll('button')) el.classList.toggle('on', el === b);
        load();
      });

      $('#q').addEventListener('input', () => {
        clearTimeout(timer);
        timer = setTimeout(load, 300);
      });

      $('#do-login').addEventListener('click', async () => {
        const password = $('#pw').value;
        $('#login-msg').textContent = '验证中…';
        const res = await fetch('/api/admin/login', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ password }),
        });
        if (res.ok) {
          show('panel');
          load();
        } else {
          const d = await res.json().catch(() => ({}));
          $('#login-msg').textContent = d.message || (d.error === 'bad_password' ? '密码不正确' : '登录失败');
        }
      });

      $('#pw').addEventListener('keydown', (e) => {
        if (e.key === 'Enter') $('#do-login').click();
      });

      $('#logout').addEventListener('click', async () => {
        await fetch('/api/admin/logout', { method: 'POST' });
        show('login');
      });

      (async () => {
        const res = await fetch('/api/admin/inquiries?status=new', { headers: { accept: 'application/json' } });
        if (res.status === 401) return show('login');
        const data = await res.json().catch(() => ({}));
        if (!res.ok && (data.error === 'not_configured' || data.error === 'no_database')) {
          $('#boot').innerHTML = `<div class="err">${esc(data.message || data.error)}</div>`;
          return;
        }
        show('panel');
        load();
      })();
    </script>
  </body>
</html>
