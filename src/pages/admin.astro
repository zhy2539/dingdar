---
// 询盘后台。纯静态页 + 同源接口（/api/admin/*），不进 sitemap、不参与索引。
// 注意：样式必须用 is:global —— 列表是 JS 动态插入的，标签上没有 data-astro-cid，
// 加了作用域的选择器一条都不会命中（这正是早期版本“裸表格”的原因）。
const title = '询盘后台 · DINGDAR';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <style is:global>
      :root {
        --ink: #0f172a;
        --body: #334155;
        --muted: #64748b;
        --line: #e2e8f0;
        --soft: #f1f5f9;
        --bg: #f1f3f6;
        --accent: #c2410c;
        --accent-soft: #fff2ea;
        --new: #c2410c;
        --replied: #15803d;
        --archived: #64748b;
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
        font-size: 15px;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        background: var(--soft);
        padding: 1px 5px;
        border-radius: 5px;
        font-size: 0.86em;
      }

      /* ---------- 顶栏 ---------- */
      header {
        position: sticky;
        top: 0;
        z-index: 20;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: saturate(180%) blur(12px);
        -webkit-backdrop-filter: saturate(180%) blur(12px);
        border-bottom: 1px solid var(--line);
      }
      .hd {
        max-width: 1180px;
        margin: 0 auto;
        padding: 11px 20px;
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .brand { display: flex; align-items: center; gap: 10px; }
      .brand .mark {
        width: 32px;
        height: 32px;
        border-radius: 10px;
        background: linear-gradient(135deg, #c2410c, #ea7a3c);
        color: #fff;
        display: grid;
        place-items: center;
        font-weight: 800;
        font-size: 0.8rem;
        letter-spacing: 0.02em;
        box-shadow: 0 4px 10px rgba(194, 65, 12, 0.25);
      }
      .brand b { display: block; font-size: 0.95rem; letter-spacing: 0.01em; }
      .brand small { display: block; font-size: 0.73rem; color: var(--muted); font-weight: 400; margin-top: 1px; }
      .hd .sp { margin-left: auto; }
      .hd .acts { display: flex; gap: 8px; align-items: center; }

      /* ---------- 容器 ---------- */
      .wrap { max-width: 1180px; margin: 0 auto; padding: 20px 20px 72px; }

      /* ---------- 按钮 ---------- */
      button, .btn {
        font: inherit;
        font-size: 0.84rem;
        cursor: pointer;
        border-radius: 9px;
        border: 1px solid var(--line);
        background: #fff;
        padding: 6px 12px;
        color: var(--body);
        display: inline-flex;
        align-items: center;
        gap: 5px;
        text-decoration: none;
        transition: background 0.14s, border-color 0.14s, color 0.14s;
        white-space: nowrap;
      }
      button:hover, .btn:hover { background: #f8fafc; border-color: #cbd5e1; text-decoration: none; }
      button:disabled { opacity: 0.5; cursor: default; }
      .btn--primary { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 600; }
      .btn--primary:hover { background: #a33609; border-color: #a33609; }
      .btn--sm { font-size: 0.79rem; padding: 4px 9px; border-radius: 7px; }

      /* ---------- 统计卡 / 筛选 ---------- */
      .stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
        margin-bottom: 16px;
      }
      .stat {
        text-align: left;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 12px 14px;
        cursor: pointer;
        transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
        padding-right: 14px;
      }
      .stat:hover { border-color: #cbd5e1; transform: translateY(-1px); }
      .stat b {
        display: block;
        font-size: 1.5rem;
        line-height: 1.15;
        font-variant-numeric: tabular-nums;
        letter-spacing: -0.02em;
      }
      .stat span { font-size: 0.76rem; color: var(--muted); }
      .stat.on { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(194, 65, 12, 0.1); }
      .stat[data-status="new"] b { color: var(--new); }
      .stat[data-status="replied"] b { color: var(--replied); }
      .stat[data-status="archived"] b { color: var(--archived); }
      .stat.on b { color: var(--accent); }

      /* ---------- 工具条 ---------- */
      .toolbar { display: flex; gap: 10px; align-items: center; margin-bottom: 14px; }
      .search { position: relative; flex: 1; max-width: 420px; }
      .search svg {
        position: absolute;
        left: 11px;
        top: 50%;
        transform: translateY(-50%);
        width: 15px;
        height: 15px;
        color: var(--muted);
        pointer-events: none;
      }
      input[type="password"], input[type="search"] {
        font: inherit;
        font-size: 0.88rem;
        padding: 9px 12px;
        border: 1px solid var(--line);
        border-radius: 9px;
        width: 100%;
        background: #fff;
        color: var(--ink);
        outline: none;
        transition: border-color 0.15s, box-shadow 0.15s;
      }
      input[type="search"] { padding-left: 33px; }
      input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(194, 65, 12, 0.1); }

      /* ---------- 询盘卡片 ---------- */
      .list { display: flex; flex-direction: column; gap: 10px; }
      .inq {
        position: relative;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 13px;
        padding: 15px 17px 13px 21px;
        transition: box-shadow 0.16s, border-color 0.16s;
      }
      .inq::before {
        content: "";
        position: absolute;
        left: 0;
        top: 13px;
        bottom: 13px;
        width: 3px;
        border-radius: 0 3px 3px 0;
        background: var(--new);
      }
      .inq[data-status="replied"]::before { background: var(--replied); }
      .inq[data-status="archived"]::before { background: var(--archived); opacity: 0.5; }
      .inq[data-status="archived"] { background: #fbfcfd; }
      .inq[data-status="archived"] .who .n { color: var(--body); font-weight: 600; }
      .inq:hover { box-shadow: 0 6px 22px rgba(15, 23, 42, 0.07); border-color: #d8dee7; }

      .ihead { display: flex; align-items: center; gap: 7px; flex-wrap: wrap; margin-bottom: 11px; }
      .pill {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 2px 9px;
        border-radius: 999px;
        letter-spacing: 0.01em;
        white-space: nowrap;
      }
      .pill--new { background: var(--accent-soft); color: var(--accent); }
      .pill--replied { background: #e7f6ed; color: var(--replied); }
      .pill--archived { background: #eef1f5; color: var(--archived); }
      .pill--inq { background: #eef2ff; color: #4338ca; }
      .pill--sample { background: #f5ecfe; color: #7c3aed; }
      .pill--doc { background: #e6f6f8; color: #0e7490; }
      .pill--lang { background: var(--soft); color: #475569; font-weight: 600; }
      .pill--dot::before {
        content: "";
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: currentColor;
      }
      .time { margin-left: auto; font-size: 0.76rem; color: var(--muted); text-align: right; white-space: nowrap; }
      .time b { color: var(--body); font-weight: 600; }
      .time i { font-style: normal; opacity: 0.75; }

      .igrid { display: grid; grid-template-columns: 196px minmax(0, 1fr); gap: 20px; }
      .who .n { font-weight: 700; font-size: 1rem; line-height: 1.35; color: var(--ink); word-break: break-word; }
      .who .c { font-size: 0.84rem; color: var(--body); margin-top: 3px; word-break: break-word; }
      .who .loc { font-size: 0.79rem; color: var(--muted); margin-top: 3px; }
      .who .links { margin-top: 9px; display: flex; flex-direction: column; gap: 5px; }
      .who .links a, .who .links span {
        font-size: 0.8rem;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        word-break: break-all;
        line-height: 1.4;
      }
      .who .links a { color: #1d4ed8; }
      .who .links .wa { color: #15803d; }
      .who .links svg { width: 13px; height: 13px; flex: 0 0 13px; opacity: 0.75; }

      .lbl {
        font-size: 0.69rem;
        font-weight: 700;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 5px;
      }
      .msg { font-size: 0.91rem; line-height: 1.72; color: var(--body); white-space: pre-wrap; word-break: break-word; }
      .msg.clamp { display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
      .msg .none { color: var(--muted); }
      .more {
        background: none;
        border: 0;
        padding: 0;
        margin-top: 4px;
        color: var(--accent);
        font-size: 0.79rem;
        cursor: pointer;
      }
      .more:hover { background: none; text-decoration: underline; }

      .facts { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 11px; }
      .fact {
        background: var(--soft);
        border-radius: 8px;
        padding: 5px 10px;
        font-size: 0.79rem;
        color: var(--body);
        display: inline-flex;
        align-items: baseline;
        gap: 6px;
        max-width: 100%;
      }
      .fact i { font-style: normal; font-size: 0.69rem; color: var(--muted); letter-spacing: 0.04em; white-space: nowrap; }
      .fact b { font-weight: 600; color: var(--ink); word-break: break-word; }
      .fact a { font-weight: 600; }

      .ifoot {
        margin-top: 13px;
        padding-top: 11px;
        border-top: 1px dashed var(--line);
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
      }
      .src { font-size: 0.78rem; color: var(--muted); display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
      .src svg { width: 13px; height: 13px; opacity: 0.7; }
      .src b { color: var(--body); font-weight: 600; }
      .ifoot .acts { margin-left: auto; display: flex; gap: 6px; flex-wrap: wrap; }

      /* ---------- 空态 / 错误 ---------- */
      .state {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 13px;
        padding: 56px 24px;
        text-align: center;
        color: var(--muted);
        font-size: 0.9rem;
      }
      .state svg { width: 38px; height: 38px; margin-bottom: 10px; opacity: 0.35; }
      .state b { display: block; color: var(--body); font-size: 0.95rem; margin-bottom: 3px; }
      .state--err { color: #b42318; border-color: #f3d2cd; background: #fff8f7; }

      /* ---------- 登录 ---------- */
      #login { max-width: 372px; margin: 13vh auto 0; }
      .login-card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 26px;
        box-shadow: 0 10px 34px rgba(15, 23, 42, 0.07);
      }
      .login-card .mark {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        background: linear-gradient(135deg, #c2410c, #ea7a3c);
        color: #fff;
        display: grid;
        place-items: center;
        font-weight: 800;
        font-size: 0.92rem;
        margin-bottom: 16px;
        box-shadow: 0 5px 14px rgba(194, 65, 12, 0.28);
      }
      .login-card h2 { margin: 0 0 5px; font-size: 1.08rem; }
      .login-card p { margin: 0 0 16px; color: var(--muted); font-size: 0.84rem; line-height: 1.6; }
      .login-card .row { display: flex; gap: 9px; align-items: center; margin-top: 12px; }
      .login-card .row span { font-size: 0.82rem; color: var(--muted); }

      .sub { color: var(--muted); font-size: 0.8rem; }

      /* ---------- 响应式 ---------- */
      @media (max-width: 860px) {
        .stats { grid-template-columns: repeat(2, 1fr); }
      }
      @media (max-width: 740px) {
        .wrap { padding: 14px 13px 60px; }
        .igrid { grid-template-columns: 1fr; gap: 13px; }
        .inq { padding: 14px 14px 12px 18px; }
        .time { width: 100%; margin-left: 0; text-align: left; order: 9; }
        .ihead .time { margin-left: 0; }
        .ifoot .acts { margin-left: 0; width: 100%; }
        .ifoot .acts button, .ifoot .acts a { flex: 1; justify-content: center; }
        .brand small { display: none; }
        .hd { padding: 10px 13px; }
        .toolbar { flex-wrap: wrap; }
        .search { max-width: none; }
        .stat b { font-size: 1.3rem; }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="hd">
        <div class="brand">
          <span class="mark">DD</span>
          <span>
            <b>询盘后台</b>
            <small>DINGDAR · dingdar.com</small>
          </span>
        </div>
        <span class="sp"></span>
        <div class="acts">
          <a class="btn" id="site-link" href="/" target="_blank" rel="noopener">打开网站</a>
          <button id="logout" hidden>退出</button>
        </div>
      </div>
    </header>

    <div class="wrap">
      <section id="login" hidden>
        <div class="login-card">
          <span class="mark">DD</span>
          <h2>登录询盘后台</h2>
          <p>输入后台密码。密码保存在 Cloudflare Pages 的环境变量 <code>ADMIN_PASSWORD</code> 中。</p>
          <input id="pw" type="password" autocomplete="current-password" placeholder="后台密码" />
          <div class="row">
            <button class="btn--primary" id="do-login">登录</button>
            <span id="login-msg"></span>
          </div>
        </div>
      </section>

      <section id="panel" hidden>
        <div class="stats" id="stats">
          <button class="stat on" data-status="new"><b id="c-new">0</b><span>待处理</span></button>
          <button class="stat" data-status="replied"><b id="c-replied">0</b><span>已回复</span></button>
          <button class="stat" data-status="archived"><b id="c-archived">0</b><span>已归档</span></button>
          <button class="stat" data-status="all"><b id="c-total">0</b><span>累计收到</span></button>
        </div>

        <div class="toolbar">
          <div class="search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.2-3.2"></path></svg>
            <input id="q" type="search" placeholder="搜索姓名、公司、邮箱、国家、正文…" />
          </div>
          <a class="btn" id="export" href="/api/admin/export" download>导出 CSV</a>
        </div>

        <div class="list" id="list"></div>
      </section>

      <div id="boot" class="state">加载中…</div>
    </div>

    <script is:inline>
      const $ = (s) => document.querySelector(s);
      let status = 'new';
      let timer = null;

      const esc = (s) =>
        String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

      /* ---------- 时间 ---------- */
      const pad = (n) => String(n).padStart(2, '0');
      const fmt = (iso) => {
        if (!iso) return '';
        const d = new Date(iso);
        if (Number.isNaN(d.getTime())) return iso;
        return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
      };
      const rel = (iso) => {
        const d = new Date(iso);
        if (Number.isNaN(d.getTime())) return '';
        const diff = (Date.now() - d.getTime()) / 1000;
        if (diff < 90) return '刚刚';
        if (diff < 3600) return `${Math.floor(diff / 60)} 分钟前`;
        if (diff < 86400) return `${Math.floor(diff / 3600)} 小时前`;
        if (diff < 86400 * 30) return `${Math.floor(diff / 86400)} 天前`;
        return `${Math.floor(diff / 86400 / 30)} 个月前`;
      };

      /* ---------- 字段解析 ---------- */
      const LANGS = { en: '英语', es: '西班牙语', fr: '法语', pt: '葡萄牙语', ru: '俄语', zh: '中文' };
      const LOCALES = ['es', 'fr', 'pt', 'ru'];

      const parseExtra = (raw) => {
        try {
          const o = JSON.parse(raw || '{}');
          return o && typeof o === 'object' ? o : {};
        } catch {
          return {};
        }
      };

      const STATUS_LABEL = { new: '待处理', replied: '已回复', archived: '已归档' };

      // 表单类型：靠 _subject 区分，三类表单文案固定
      function kindOf(ex) {
        const s = String(ex._subject || '').toLowerCase();
        if (s.includes('sample')) return { t: '样品申请', c: 'sample' };
        if (s.includes('profile') || s.includes('download')) return { t: '资料下载', c: 'doc' };
        return { t: '产品询盘', c: 'inq' };
      }

      // 来源页面：优先用表单带上来的 source_title，其次按路径推断
      const PAGE_LABEL = {
        '': '首页',
        contact: '联系页',
        'request-sample': '样品申请页',
        about: '关于我们',
        products: '产品页',
        news: '文章页',
        faq: '常见问题',
        materials: '材质对照表',
        industries: '行业应用页',
        'thank-you': '感谢页',
      };

      function sourceOf(it, ex) {
        const raw = String(it.source_page || '');
        let path = raw;
        let host = '';
        if (/^https?:/i.test(raw)) {
          try {
            const u = new URL(raw);
            path = u.pathname;
            host = u.host;
          } catch {
            /* 保持原样 */
          }
        }
        const segs = path.split('/').filter(Boolean);
        let loc = '';
        if (LOCALES.includes(segs[0])) loc = segs.shift();
        const head = segs[0] || '';
        const tail = segs[1] || '';
        let label = PAGE_LABEL[head] || (head ? head : '首页');
        let detail = '';
        if (head === 'products' && tail) { label = '产品页'; detail = tail; }
        if (head === 'news' && tail) { label = '文章页'; detail = tail; }
        if (head === 'industries' && tail) { label = '行业应用页'; detail = tail; }
        return {
          title: String(ex.source_title || '').trim(),
          label,
          detail,
          path: path || '—',
          loc,
          host: host && host !== 'dingdar.com' ? host : '',
        };
      }

      const waNumber = (phone) => String(phone || '').replace(/[^\d]/g, '');

      /* ---------- 图标 ---------- */
      const I = {
        mail: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4.5" width="19" height="15" rx="2.5"/><path d="m3 7 9 6 9-6"/></svg>',
        phone: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5L16 12l4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4 6.2 2 2 0 0 1 6 4z"/></svg>',
        globe: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18"/></svg>',
        pin: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>',
        inbox: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h5l2 3h4l2-3h5"/><path d="M5.5 5h13l2.5 7v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-5z"/></svg>',
      };

      /* ---------- 视图切换 ---------- */
      function show(view) {
        $('#boot').hidden = true;
        $('#login').hidden = view !== 'login';
        $('#panel').hidden = view !== 'panel';
        $('#logout').hidden = view !== 'panel';
      }

      /* ---------- 加载 ---------- */
      async function load() {
        const q = $('#q').value.trim();
        const url = `/api/admin/inquiries?status=${encodeURIComponent(status)}&q=${encodeURIComponent(q)}`;
        let res;
        try {
          res = await fetch(url, { headers: { accept: 'application/json' } });
        } catch {
          $('#list').innerHTML = `<div class="state state--err"><b>网络异常</b>读不到数据，请刷新重试。</div>`;
          return;
        }
        if (res.status === 401) return show('login');
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          $('#list').innerHTML = `<div class="state state--err"><b>读取失败</b>${esc(data.message || data.error || '未知错误')}</div>`;
          return;
        }
        const s = data.stats || {};
        $('#c-new').textContent = s.new ?? 0;
        $('#c-replied').textContent = s.replied ?? 0;
        $('#c-archived').textContent = s.archived ?? 0;
        $('#c-total').textContent = s.total ?? 0;
        $('#export').href = `/api/admin/export?status=${encodeURIComponent(status)}`;
        render(data.items || []);
      }

      /* ---------- 渲染一条询盘 ---------- */
      function card(it) {
        const ex = parseExtra(it.extra);
        const kind = kindOf(ex);
        const srcInfo = sourceOf(it, ex);
        const langCode = String(it.lang || ex.page_language || '').toLowerCase();
        const langLabel = LANGS[langCode] || '';
        const st = STATUS_LABEL[it.status] || it.status;

        // 联系人
        const links = [];
        if (it.email) {
          const subj = encodeURIComponent(`Re: ${kind.t} — ${it.company || it.name || 'dingdar.com'}`);
          links.push(`<a href="mailto:${esc(it.email)}?subject=${subj}">${I.mail}${esc(it.email)}</a>`);
        }
        if (it.phone) {
          const n = waNumber(it.phone);
          links.push(
            n.length >= 7
              ? `<a class="wa" href="https://wa.me/${esc(n)}" target="_blank" rel="noopener">${I.phone}${esc(it.phone)} · WhatsApp</a>`
              : `<span>${I.phone}${esc(it.phone)}</span>`
          );
        }

        // 「要什么」：正文 + 结构化补充信息
        const msgRaw = String(it.message || '');
        const long = msgRaw.length > 240 || msgRaw.split('\n').length > 4;
        const facts = [];
        const addFact = (label, value, href) => {
          const v = String(value || '').trim();
          if (!v) return;
          facts.push(
            `<span class="fact"><i>${label}</i>${href ? `<a href="${esc(href)}" target="_blank" rel="noopener">查看附件/图纸</a>` : `<b>${esc(v)}</b>`}</span>`
          );
        };
        addFact('产品兴趣', ex.product);
        addFact('年用量 / 数量', ex.quantity);
        addFact('图纸 / 参考链接', ex.reference_url, ex.reference_url);
        addFact('产品上下文', ex.product_context);
        addFact('样品 / 资料', ex.document || ex.catalogue);

        // 「从哪来」
        const srcTitle = srcInfo.title || srcInfo.label;
        const srcBits = [];
        srcBits.push(`<b>${esc(srcTitle)}</b>`);
        if (srcInfo.detail) srcBits.push(`<code>${esc(srcInfo.detail)}</code>`);
        if (srcInfo.loc) srcBits.push(`${esc(LANGS[srcInfo.loc] || srcInfo.loc)}站`);
        if (langLabel) srcBits.push(`表单语言 ${esc(langLabel)}`);
        if (srcInfo.host) srcBits.push(esc(srcInfo.host));

        // 操作
        const actBtn = (to, label) =>
          it.status === to ? '' : `<button class="btn btn--sm" data-id="${it.id}" data-to="${to}">${label}</button>`;
        const mailBtn = it.email
          ? `<a class="btn btn--sm ${it.status === 'new' ? 'btn--primary' : ''}" href="mailto:${esc(it.email)}?subject=${encodeURIComponent(
              `Re: ${kind.t} — ${it.company || it.name || 'dingdar.com'}`
            )}">回复邮件</a>`
          : '';

        return `<article class="inq" data-status="${esc(it.status)}">
          <div class="ihead">
            <span class="pill pill--${esc(it.status)} pill--dot">${esc(st)}</span>
            <span class="pill pill--${kind.c}">${esc(kind.t)}</span>
            ${langLabel ? `<span class="pill pill--lang">${esc(langLabel)}</span>` : ''}
            <span class="time"><b>${esc(rel(it.created_at))}</b> <i>· ${esc(fmt(it.created_at))}</i></span>
          </div>

          <div class="igrid">
            <div class="who">
              <div class="n">${esc(it.name || '（未填姓名）')}</div>
              <div class="c">${esc(it.company || '（未填公司）')}</div>
              ${it.country ? `<div class="loc">${esc(it.country)}</div>` : ''}
              <div class="links">${links.join('') || '<span class="sub">无联系方式</span>'}</div>
            </div>

            <div class="what">
              <div class="lbl">要什么</div>
              <div class="msg ${long ? 'clamp' : ''}" data-msg>${
                msgRaw ? esc(msgRaw) : '<span class="none">（正文为空，请查看附件或结构化字段）</span>'
              }</div>
              ${long ? '<button class="more" data-expand>展开全文</button>' : ''}
              ${facts.length ? `<div class="facts">${facts.join('')}</div>` : ''}
            </div>
          </div>

          <div class="ifoot">
            <span class="src">${I.pin}来自 ${srcBits.join(' · ')}</span>
            <div class="acts">
              ${mailBtn}
              ${actBtn('replied', '标记已回复')}
              ${actBtn('archived', '归档')}
              ${actBtn('new', '重置为新')}
            </div>
          </div>
        </article>`;
      }

      function render(items) {
        if (!items.length) {
          const hint =
            status === 'new'
              ? '新询盘会出现在这里。表单已接 Cloudflare 数据库，提交即刻入库。'
              : '这个分类下暂无询盘。';
          $('#list').innerHTML = `<div class="state">${I.inbox}<b>暂无询盘</b>${esc(hint)}</div>`;
          return;
        }
        $('#list').innerHTML = items.map(card).join('');
      }

      /* ---------- 事件 ---------- */
      document.addEventListener('click', async (e) => {
        const t = e.target;
        const expand = t.closest('[data-expand]');
        if (expand) {
          const box = expand.parentElement.querySelector('[data-msg]');
          const collapsed = box.classList.toggle('clamp');
          expand.textContent = collapsed ? '展开全文' : '收起';
          return;
        }
        const btn = t.closest('button[data-to]');
        if (btn) {
          btn.disabled = true;
          try {
            await fetch('/api/admin/update', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ id: Number(btn.dataset.id), status: btn.dataset.to }),
            });
          } catch {
            /* 忽略，靠 load() 反映真实状态 */
          }
          load();
        }
      });

      $('#stats').addEventListener('click', (e) => {
        const b = e.target.closest('.stat[data-status]');
        if (!b) return;
        status = b.dataset.status;
        for (const el of $('#stats').querySelectorAll('.stat')) el.classList.toggle('on', el === b);
        load();
      });

      $('#q').addEventListener('input', () => {
        clearTimeout(timer);
        timer = setTimeout(load, 300);
      });

      $('#do-login').addEventListener('click', async () => {
        const password = $('#pw').value;
        if (!password) return;
        $('#login-msg').textContent = '验证中…';
        let res;
        try {
          res = await fetch('/api/admin/login', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ password }),
          });
        } catch {
          $('#login-msg').textContent = '网络异常，请重试';
          return;
        }
        if (res.ok) {
          $('#pw').value = '';
          show('panel');
          load();
        } else {
          const d = await res.json().catch(() => ({}));
          $('#login-msg').textContent = d.message || (d.error === 'bad_password' ? '密码不正确' : '登录失败');
        }
      });

      $('#pw').addEventListener('keydown', (e) => {
        if (e.key === 'Enter') $('#do-login').click();
      });

      $('#logout').addEventListener('click', async () => {
        try {
          await fetch('/api/admin/logout', { method: 'POST' });
        } catch {
          /* ignore */
        }
        show('login');
      });

      /* ---------- 启动 ---------- */
      (async () => {
        let res;
        try {
          res = await fetch('/api/admin/inquiries?status=new', { headers: { accept: 'application/json' } });
        } catch {
          $('#boot').className = 'state state--err';
          $('#boot').innerHTML = '<b>网络异常</b>无法连接后台接口，请刷新重试。';
          return;
        }
        if (res.status === 401) return show('login');
        const data = await res.json().catch(() => ({}));
        if (!res.ok && (data.error === 'not_configured' || data.error === 'no_database')) {
          $('#boot').className = 'state state--err';
          $('#boot').innerHTML = `<b>后台尚未配置</b>${esc(data.message || data.error)}`;
          return;
        }
        if (!res.ok) return show('login');
        show('panel');
        load();
      })();
    </script>
  </body>
</html>
