---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import FaqList from '../../components/FaqList.astro';
import { SITE } from '../../data/config';

const path = '/industries/cement/';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.domain + '/' },
    { '@type': 'ListItem', position: 2, name: 'Industries', item: SITE.domain + '/industries/cement/' },
    { '@type': 'ListItem', position: 3, name: 'Cement & Aggregate', item: SITE.domain + path },
  ],
};

const stages = [
  {
    stage: 'Quarry and limestone crushing',
    parts: 'Jaw plates, blow bars, impact plates, hammer heads, apron and breaker plates',
    grade: 'Mn18Cr2 for slabby blast feed; high-chromium iron (Cr15–Cr26) for abrasive, already-reduced feed',
    note: 'Limestone is soft but often silica-bearing. Wear here is a mix of impact and scratching, so the grade choice follows the feed gradation rather than the rock name.',
  },
  {
    stage: 'Raw mill and cement mill',
    parts: 'Shell liners, head and end liners, lifter bars, grate plates, diaphragm plates',
    grade: 'Pearlitic chrome-moly steel for large sections; Mn18Cr2 where impact dominates; high-chromium iron in the fine chambers',
    note: 'A flattened lifter profile costs throughput long before the liner is worn through — the mill keeps drawing power while grinding less.',
  },
  {
    stage: 'Kiln and preheater',
    parts: 'Cast wear plates, chute and duct liners, chain-system components cast to drawing',
    grade: 'Heat-resistant alloy steel grades to the plant specification',
    note: 'Hot, abrasive and often slightly reducing. Geometry and alloy are set by the drawing and the operating temperature, not by a catalogue number.',
  },
  {
    stage: 'Clinker cooler',
    parts: 'Grate plates, cast wear plates and side liners',
    grade: 'Heat-resistant and abrasion-resistant grades, selected per position',
    note: 'Thermal cycling is the dominant failure mode, not abrasion. Cracking at the fixing points is the signal to review the alloy and the clamping, not just the plate thickness.',
  },
  {
    stage: 'Conveying, chutes and silos',
    parts: 'Chute liners, hopper liners, wear plates, impact beds',
    grade: 'High-chromium iron for sliding abrasion; alloy steel where the plate is structural',
    note: 'The cheapest wear plate on the line is often the one that was specified from the material actually flowing — wet, sticky or free-flowing changes the answer.',
  },
];

const checks = [
  { k: 'Read the failure, not just the wear', v: 'A plate worn thin in the middle is an abrasion problem. A plate cracked at the bolt holes or curled at the edge is a fixing, thermal or impact problem, and a harder alloy will make it worse.' },
  { k: 'Match the grade to the chamber', v: 'The coarse chamber of a mill and the fine chamber see different media and different energy. One grade across both is a compromise that usually costs throughput in one of them.' },
  { k: 'Keep the profile in the specification', v: 'Lifter height, face angle and plate thickness together decide how the charge behaves. A replacement that is dimensionally correct but profiled differently is a different part.' },
  { k: 'Document scope before production', v: 'Material certificate, hardness, dimensional report and visual inspection are agreed before casting, so the release documents match what the plant actually needs.' },
];

const faqs = [
  { q: 'Can you match a cement plant OEM part number?', a: 'Yes. Send the OEM number with the equipment model and, where available, a photo or a worn part. Geometry and alloy are confirmed in a written technical review before pattern work begins, which is also where any deviation from the original is raised rather than after delivery.' },
  { q: 'Which grade do you recommend for mill liners in cement grinding?', a: 'It depends on the chamber. Large-diameter first chambers with coarse media usually justify a pearlitic chrome-moly steel or Mn18Cr2, where toughness and section thickness matter. Fine chambers running small media and high circulating loads generally favour a high-chromium iron for abrasion resistance. Mill diameter, media size and the wear pattern decide the split.' },
  { q: 'Do you cast heat-resistant parts for kiln and cooler positions?', a: 'Castings for kiln, preheater and cooler positions are produced to drawing, in the alloy the plant specifies. Send the drawing, the operating temperature and the current failure mode, and the feasible alloy range is confirmed in the review.' },
  { q: 'How do you handle a part that fails early?', a: 'The first step is the evidence: the failed part, photographs, the batch record and the operating conditions. Non-conformance is addressed with corrective action and replacement per the agreed terms, and the finding is carried into the next specification rather than left as a credit note.' },
  { q: 'What documentation ships with a cement plant order?', a: 'Material certificates with heat analysis, dimensional inspection reports, hardness records and visual inspection records, plus NDT or third-party inspection when the project specifies it. The exact document set is agreed with the purchase order.' },
];
---

<BaseLayout
  image="/images/banner-hammer-og.webp"
  title="Cement Plant Wear Parts — Crusher &amp; Mill Castings | DINGDAR"
  description="Crusher wear parts, mill liners, grate plates and cast wear plates for cement plants and quarries, produced to drawing or OEM part number since 1986."
  path={path}
  alternateLangs={['en']}
  jsonLd={[
    breadcrumbLd,
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'Wear Parts for Cement Plants and Quarries',
      url: SITE.domain + path,
      about: 'Crusher, mill and kiln-line wear parts for cement and aggregate production',
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Jaw crusher wear parts', url: SITE.domain + '/products/jaw-crusher-wear-parts/' },
          { '@type': 'ListItem', position: 2, name: 'Impact crusher wear parts', url: SITE.domain + '/products/impact-crusher-wear-parts/' },
          { '@type': 'ListItem', position: 3, name: 'Hammer crusher wear parts', url: SITE.domain + '/products/hammer-crusher-wear-parts/' },
          { '@type': 'ListItem', position: 4, name: 'Double roll crusher wear parts', url: SITE.domain + '/products/double-roll-crusher-wear-parts/' },
          { '@type': 'ListItem', position: 5, name: 'Ball mill liners', url: SITE.domain + '/ball-mill-liners/' },
          { '@type': 'ListItem', position: 6, name: 'Custom castings', url: SITE.domain + '/products/custom-castings/' },
        ],
      },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ]}
>
  <PageHero
    eyebrow="Cement & aggregate"
    title="Wear Parts for Cement Plants and Quarries"
    lead="From the primary crusher to the cement mill and the cooler line — cast wear parts matched to the position, the media and the failure mode, in manganese, high-chromium and chrome-moly grades."
    img="/images/banner-hammer.webp"
    imgAlt="Hammer crusher wear parts for limestone crushing"
    ctaPrimary={{ label: 'Request a Technical Review', href: '/contact/' }}
    ctaSecondary={{ label: 'See Material Grades', href: '/materials/' }}
  />

  <section class="section">
    <div class="container" style="max-width:920px;">
      <div class="sec-head">
        <span class="eyebrow">One line, six wear regimes</span>
        <h2>The Plant Wears Differently at Every Stage</h2>
      </div>
      <p style="font-size:1.04rem;line-height:1.85;color:var(--body);margin-bottom:18px;">
        A cement line is usually discussed as one process, but the wear mechanisms along it have almost
        nothing in common. Limestone crushing is impact with a silica edge. Raw and cement milling is
        abrasion under a grinding charge. The kiln and cooler add heat, thermal cycling and oxidation to
        the picture. A single "wear resistant" grade applied across all of them is a compromise that shows
        up as short life in at least one position.
      </p>
      <p style="font-size:1.04rem;line-height:1.85;color:var(--body);margin-bottom:18px;">
        The practical consequence is that the specification has to travel with the position. The same
        foundry can cast the jaw plate, the mill liner and the cooler plate, but the alloy, the heat
        treatment and the inspection scope are different decisions for each.
      </p>
      <p style="font-size:1.04rem;line-height:1.85;color:var(--body);margin-bottom:0;">
        DINGDAR casts in green sand, shell moulding, lost foam and investment, with heat treatment,
        machining and inspection in the same plant, so a mixed order for the crushing, milling and
        kiln-line positions is reviewed and released as one project rather than three unrelated purchases.
      </p>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="sec-head">
        <span class="eyebrow">Position by position</span>
        <h2>Where Wear Parts Sit on a Cement Line</h2>
        <p>Five stages account for most of the consumable spend.</p>
      </div>
      <div class="card" style="overflow-x:auto;">
        <table class="tbl">
          <thead>
            <tr><th>Stage</th><th>Typical parts</th><th>Grades usually specified</th><th>What decides life here</th></tr>
          </thead>
          <tbody>
            {stages.map((s) => (
              <tr>
                <td><strong>{s.stage}</strong></td>
                <td>{s.parts}</td>
                <td>{s.grade}</td>
                <td>{s.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p style="font-size:0.88rem;color:var(--muted);margin-top:14px;">
        Parts for kiln and cooler positions are produced to the plant's drawing and alloy specification;
        the grade families and their behaviour are set out on the
        <a href="/materials/" style="color:var(--accent);font-weight:600;">wear-part materials</a> page.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:920px;">
      <div class="sec-head">
        <span class="eyebrow">Specification discipline</span>
        <h2>Four Things That Decide Whether the Next Set Lasts</h2>
      </div>
      <div style="margin-top:26px;">
        {checks.map((c) => (
          <div style="margin-bottom:22px;">
            <h3 style="font-size:1.12rem;margin-bottom:8px;color:var(--ink);">{c.k}</h3>
            <p style="font-size:1.02rem;line-height:1.8;color:var(--body);margin:0;">{c.v}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container" style="max-width:920px;">
      <div class="sec-head">
        <span class="eyebrow">Questions buyers ask</span>
        <h2>Cement &amp; Aggregate Wear Parts FAQ</h2>
      </div>
      <FaqList items={faqs} />
      <p style="margin-top:26px;font-size:1.02rem;color:var(--body);">
        Further reading:
        <a href="/news/green-sand-vs-investment-casting/" style="color:var(--accent);font-weight:600;text-decoration:underline;text-underline-offset:3px;">
          choosing between green sand and investment casting
        </a>
        and
        <a href="/news/what-inspection-records-should-buyers-request-for-crusher-wear-parts/" style="color:var(--accent);font-weight:600;text-decoration:underline;text-underline-offset:3px;">
          which inspection records to request
        </a>.
      </p>
    </div>
  </section>

  <CtaBand
    title="Send the Position, Not Just the Part Name"
    text="Tell us the stage, the equipment and how the last part failed — we confirm alloy, geometry and inspection scope and reply with technical feedback within 12–24 hours."
    cta="Request a Quote"
  />
</BaseLayout>

