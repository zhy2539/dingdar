---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import { NEWS, getNews } from '../../data/news';
import { getCategory } from '../../data/products';
import { newsTranslationLangs } from '../../i18n';

export function getStaticPaths() {
  return NEWS.map((n) => ({ params: { slug: n.slug } }));
}

const { slug } = Astro.params;
const news = getNews(slug!);

if (!news) {
  return Astro.redirect('/news/');
}

const { title, date, excerpt, cover, coverAlt, body } = news;
const idx = NEWS.findIndex((item) => item.slug === slug);
const alternateLangs = newsTranslationLangs(idx, body.length);
const relatedProductSlugs: Record<number, string[]> = {
  0: ['jaw-crusher-wear-parts'],
  1: ['jaw-crusher-wear-parts'],
  2: ['jaw-crusher-wear-parts', 'cone-crusher-wear-parts', 'custom-castings'],
  3: ['custom-castings'],
  4: ['jaw-crusher-wear-parts'],
  5: ['custom-castings', 'jaw-crusher-wear-parts', 'cone-crusher-wear-parts', 'impact-crusher-wear-parts'],
  6: ['jaw-crusher-wear-parts', 'cone-crusher-wear-parts', 'impact-crusher-wear-parts'],
  7: ['jaw-crusher-wear-parts', 'cone-crusher-wear-parts', 'impact-crusher-wear-parts'],
  8: ['cone-crusher-wear-parts', 'jaw-crusher-wear-parts'],
  9: ['impact-crusher-wear-parts', 'hammer-crusher-wear-parts'],
  10: ['custom-castings'],
  11: ['jaw-crusher-wear-parts'],
};
const relatedProducts = (relatedProductSlugs[idx] || []).map((productSlug) => {
  const product = getCategory(productSlug)!;
  return { href: `/products/${productSlug}/`, label: product.shortName };
});
---

<BaseLayout
  title={`${title}`}
  description={excerpt}
  path={`/news/${slug}/`}
  image={cover.replace('.webp', '-og.webp')}
  alternateLangs={alternateLangs}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    headline: title,
    datePublished: date,
    description: excerpt,
    image: 'https://dingdar.com' + cover,
    author: { '@type': 'Organization', name: 'DINGDAR Casting' },
    publisher: { '@type': 'Organization', name: 'Henan Dingdar Machinery Equipment Manufacture Co., Ltd.' },
  }}>
  <section class="section" style="padding-top:64px;">
    <div class="container" style="max-width:860px;">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> / <a href="/news/">News</a> / <span>{title}</span>
      </nav>
      <span class="badge">{date}</span>
      <h1 style="margin-top:18px;margin-bottom:26px;">{title}</h1>
      <img src={cover} alt={coverAlt} width="1200" height="675" class="article-cover" />
      <div class="article-body">
        {body.map((p) => (<p set:html={p}></p>))}
      </div>
      {relatedProducts.length > 0 && (
        <nav class="article-related" aria-label="Related product pages">
          <strong>Related products:</strong>
          {relatedProducts.map((product) => <a href={product.href}>{product.label}</a>)}
          <a class="article-related__cta" href="/contact/">Request a technical review →</a>
        </nav>
      )}
      <p style="font-size:0.88rem;color:var(--muted);line-height:1.7;margin-bottom:18px;">
        Background reading: <a href="/materials/">wear-part materials compared</a> ·
        <a href="/industries/mining/">mining applications</a> ·
        <a href="/industries/cement/">cement plant applications</a>
      </p>
      <a href="/news/" class="btn btn--ghost" style="margin-top:12px;">← Back to News</a>
    </div>
  </section>

  <CtaBand
    title="Start Your Casting Project"
    text="Send a drawing, part number or equipment model — we reply with technical feedback within 12–24 hours."
    cta="Get a Quote"
  />
</BaseLayout>

<style>
  .article-body { margin-top: 32px; }
  .article-cover { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 14px; box-shadow: var(--shadow-md); }
  .article-body p { margin-bottom: 22px; font-size: 1.04rem; line-height: 1.8; color: var(--body); }
  .article-body a { color: var(--accent); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .article-related { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; margin: 32px 0 20px; padding: 20px 22px; border: 1px solid var(--line); border-radius: 14px; background: var(--bg-tint); }
  .article-related a { color: var(--accent); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .article-related__cta { margin-left: auto; }
  @media (max-width: 640px) { .article-related__cta { margin-left: 0; } }
</style>
