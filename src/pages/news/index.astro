---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { NEWS } from '../../data/news';
---

<BaseLayout
  title="News & Updates | DINGDAR Casting"
  description="Company news and updates from DINGDAR — new products, exhibitions, production developments and practical guidance for buying castings and crusher wear parts."
  path="/news/"
>
  <PageHero
    eyebrow="News & updates"
    title="News From the Foundry"
    lead="Company announcements, production developments and practical guidance for buying castings and crusher wear parts."
    img="/images/news-steel-wagons.webp"
    imgAlt="Steelworks wagons carrying vats of molten metal"
    ctaPrimary={{ label: 'Send an Inquiry', href: '/contact/' }}
    ctaSecondary={{ label: 'Browse Products', href: '/products/' }}
  />

  <section class="section">
    <div class="container">
      {NEWS.length === 0 ? (
        <div class="card" style="padding:56px 40px;text-align:center;">
          <h2 style="margin-bottom:12px;">Articles Coming Soon</h2>
          <p style="color:var(--muted);max-width:520px;margin:0 auto;">Company news and technical updates will be published here. For immediate questions, send an inquiry through the contact form.</p>
        </div>
      ) : (
        <div class="news-grid">
          {NEWS.map((n, idx) => (
            <a href={'/news/' + n.slug + '/'} class:list={["card", "card--hover", "news-card", { "news-card--featured": idx === 0 }]}>
              <div class="news-thumb"><img src={n.cover} alt={n.coverAlt} loading={idx === 0 ? 'eager' : 'lazy'} width="800" height="450" /></div>
              <div class="news-body">
                <div class="news-meta"><span class="news-date">{n.date}</span><span class="news-type">Technical update</span></div>
                <h2>{n.title}</h2>
                <p>{n.excerpt}</p>
                <span class="read-more">Read article <span aria-hidden="true">↗</span></span>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <CtaBand
    title="Have a Project in Mind?"
    text="Send a drawing, part number or equipment model — drawings are helpful but not required for the first conversation. We reply with technical feedback within 12–24 hours."
    cta="Get a Quote"
  />
</BaseLayout>

<style>
  .news-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; max-width: 1120px; margin: 0 auto; }
  .news-card { display: flex; flex-direction: column; overflow: hidden; min-width: 0; border: 1px solid color-mix(in srgb, var(--ink) 10%, transparent); background: var(--bg); }
  .news-card--featured { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(320px, .85fr); }
  .news-thumb { background: var(--bg-soft); aspect-ratio: 16 / 9; overflow: hidden; }
  .news-card--featured .news-thumb { aspect-ratio: auto; min-height: 330px; }
  .news-thumb img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .45s ease; }
  .news-body { display: flex; flex: 1; flex-direction: column; align-items: flex-start; gap: 12px; padding: 26px 28px 30px; }
  .news-card--featured .news-body { justify-content: center; padding: 42px; }
  .news-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .news-date, .news-type { font-size: .74rem; font-weight: 750; letter-spacing: .1em; text-transform: uppercase; }
  .news-date { color: var(--accent); }
  .news-type { color: var(--muted); }
  .news-body h2 { margin: 0; font-size: 1.24rem; line-height: 1.2; }
  .news-card--featured .news-body h2 { font-size: clamp(1.65rem, 3vw, 2.35rem); max-width: 600px; }
  .news-body p { margin: 0; font-size: .94rem; line-height: 1.65; color: var(--muted); }
  .read-more { margin-top: auto; padding-top: 12px; font-size: .85rem; font-weight: 750; color: var(--ink); letter-spacing: .04em; }
  .news-card:hover .news-thumb img, .news-card:focus-visible .news-thumb img { transform: scale(1.035); }
  .news-card:hover .read-more, .news-card:focus-visible .read-more { color: var(--accent); }
  .news-card:focus-visible { outline: 3px solid color-mix(in srgb, var(--accent) 55%, transparent); outline-offset: 4px; }
  @media (max-width: 820px) {
    .news-grid { grid-template-columns: 1fr; }
    .news-card--featured { grid-column: auto; display: flex; }
    .news-card--featured .news-thumb { min-height: 0; aspect-ratio: 16 / 9; }
    .news-card--featured .news-body { padding: 26px 28px 30px; }
  }
  @media (max-width: 520px) {
    .news-grid { gap: 18px; }
    .news-body, .news-card--featured .news-body { padding: 22px 20px 24px; }
    .news-body h2 { font-size: 1.12rem; }
  }
</style>
