---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { NEWS } from '../../data/news';
---

<BaseLayout
  title="News & Updates | DINGDAR Casting"
  description="Company news and updates from DINGDAR — new products, exhibitions, production developments and practical guidance for buying castings and crusher wear parts."
  path="/news/"
>
  <PageHero
    eyebrow="News & updates"
    title="News From the Foundry"
    lead="Company announcements, production developments and practical guidance for buying castings and crusher wear parts."
    img="/images/news-steel-wagons.webp"
    imgAlt="Steelworks wagons carrying vats of molten metal"
    ctaPrimary={{ label: 'Send an Inquiry', href: '/contact/' }}
    ctaSecondary={{ label: 'Browse Products', href: '/products/' }}
  />

  <section class="section">
    <div class="container">
      {NEWS.length === 0 ? (
        <div class="card" style="padding:56px 40px;text-align:center;">
          <h2 style="margin-bottom:12px;">Articles Coming Soon</h2>
          <p style="color:var(--muted);max-width:520px;margin:0 auto;">Company news and technical updates will be published here. For immediate questions, send an inquiry through the contact form.</p>
        </div>
      ) : (
        <div class="news-grid">
          {NEWS.map((n) => (
            <a href={'/news/' + n.slug + '/'} class="card card--hover news-card">
              <div class="news-thumb"><img src={n.cover} alt={n.coverAlt} loading="lazy" width="800" height="450" /></div>
              <div class="news-body">
                <span class="news-date">{n.date}</span>
                <h2>{n.title}</h2>
                <p>{n.excerpt}</p>
                <span class="read-more">Read More →</span>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <CtaBand
    title="Have a Project in Mind?"
    text="Send a drawing, part number or equipment model — drawings are helpful but not required for the first conversation. We reply with technical feedback within 12–24 hours."
    cta="Get a Quote"
  />
</BaseLayout>

<style>
  .news-grid { display: grid; gap: 32px; max-width: 860px; }
  .news-card { display: grid; grid-template-columns: 300px 1fr; overflow: hidden; }
  .news-thumb { background: var(--bg-soft); min-height: 180px; }
  .news-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .news-body { padding: 30px 32px; display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  .news-date { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }
  .news-body h2 { font-size: 1.3rem; }
  .news-body p { font-size: 0.95rem; color: var(--muted); }
  .read-more { font-size: 0.85rem; font-weight: 700; color: var(--ink); letter-spacing: 0.04em; margin-top: 6px; }
  .news-card:hover .read-more { color: var(--accent); }
  @media (max-width: 720px) {
    .news-card { grid-template-columns: 1fr; }
    .news-thumb { min-height: 0; aspect-ratio: 16/9; }
  }
</style>
