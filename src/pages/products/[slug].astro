---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import FaqList from '../../components/FaqList.astro';
import ProductCard from '../../components/ProductCard.astro';
import { CATEGORIES, getCategory } from '../../data/products';
import { PRODUCT_DEEP_DIVE } from '../../data/productDeepDive';
import { SITE } from '../../data/config';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const cat = getCategory(slug!);
if (!cat) throw new Error('Unknown category ' + slug);

const path = '/products/' + cat.slug + '/';
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': SITE.domain + path + '#breadcrumb',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.domain + '/' },
    { '@type': 'ListItem', position: 2, name: 'Products', item: SITE.domain + '/products/' },
    { '@type': 'ListItem', position: 3, name: cat.cardTitle, item: SITE.domain + path },
  ],
};
const specValue = (prefix: string) => {
  const line = cat.specs.find((s) => s.startsWith(prefix));
  return line ? line.slice(prefix.length).trim() : '';
};
const materialSpec = specValue('Material:');
const routeSpec = specValue('Casting routes:');
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': SITE.domain + path + '#service',
  name: cat.cardTitle,
  description: cat.intro,
  image: [SITE.domain + cat.heroImg, SITE.domain + cat.bannerImg],
  url: SITE.domain + path,
  serviceType: 'Custom casting and wear-part manufacturing',
  provider: { '@id': SITE.domain + '/#organization' },
  areaServed: 'Worldwide',
  // 这是报价制 B2B 服务，不是带有价格、退货或配送承诺的零售商品 Offer。
  ...(materialSpec ? { material: materialSpec } : {}),
  additionalProperty: [
    ...(materialSpec ? [{ '@type': 'PropertyValue', name: 'Material', value: materialSpec }] : []),
    ...(routeSpec ? [{ '@type': 'PropertyValue', name: 'Casting process', value: routeSpec }] : []),
  ],
  // B2B 页面采用询价模式，不输出没有公开依据的价格、评分或评论。
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: cat.selection.map((s) => ({
    '@type': 'Question',
    name: s.q,
    acceptedAnswer: { '@type': 'Answer', text: s.a },
  })),
};
const pageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': SITE.domain + path + '#webpage',
  url: SITE.domain + path,
  name: cat.title,
  description: cat.intro,
  isPartOf: { '@id': SITE.domain + '/#website' },
  about: { '@id': SITE.domain + '/#organization' },
  breadcrumb: { '@id': SITE.domain + path + '#breadcrumb' },
};
// Visible FAQ answers and FAQPage JSON-LD share the same source array.
const faqHeading = 'Buyer questions before ordering';
const customOptions = [
  'Drawing-based requirements',
  'Sample reference',
  'Custom dimensions',
  'Branding / marking',
];
const reviewSteps = ['Casting', 'Heat Treatment', 'Machining', 'Inspection & Finishing'];
const deepDive = PRODUCT_DEEP_DIVE[cat.slug];
---

<BaseLayout title={cat.title} description={cat.cardDesc} path={path} image={cat.heroImg.replace('.webp', '-og.webp')} jsonLd={[breadcrumbLd, serviceLd, faqLd, pageLd]} preloadImages={[cat.bannerImg]}>
  <PageHero
    eyebrow="Product category"
    title={cat.h1}
    lead={cat.intro}
    img={cat.bannerImg}
    imgAlt={cat.cardTitle}
    ctaPrimary={{ label: 'Request a Quote', href: '/contact/' }}
    ctaSecondary={{ label: 'Browse Parts ↓', href: '#parts' }}
  />

  <section class="section section--soft anchor" id="parts">
    <div class="container">
      <div class="sec-head center">
        <span class="eyebrow">Reference parts</span>
        <h2>Find Your Part</h2>
        <p>Representative references below. If your model or part number is not listed, send it and we will match it.</p>
      </div>
      <div class="grid grid--3">
        {cat.parts.map((p) => <ProductCard code={p.code} name={p.name} img={p.img} />)}
      </div>
      <div class="card" style="margin-top:32px;padding:26px 28px;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;">
        <div>
          <h3 style="font-size:1.1rem;">Can't Find Your Part?</h3>
          <p style="font-size:0.94rem;color:var(--muted);margin-top:6px;">Send the drawing, sample or part number — we review it against our references and existing tooling.</p>
        </div>
        <a href="/contact/" class="btn btn--primary" data-modal-open data-product={cat.cardTitle} data-product-option={cat.shortName}>Discuss Your Part</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="sec-head">
        <span class="eyebrow">OEM &amp; custom casting</span>
        <h2>Produced to Your Requirement</h2>
        <p>Beyond standard references, the same casting and review process supports custom projects.</p>
      </div>
      <div class="grid grid--4">
        {customOptions.map((o) => (
          <div class="card" style="padding:22px 24px;text-align:center;">
            <h3 style="font-size:1rem;">{o}</h3>
          </div>
        ))}
      </div>
      <div style="margin-top:36px;">
        <h3 style="margin-bottom:18px;">Casting &amp; Manufacturing Review</h3>
        <div class="grid grid--4">
          {reviewSteps.map((s, i) => (
            <div class="step"><span class="n"></span><h3>{s}</h3><p>Stage {i + 1} of the production review path.</p></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="sec-head">
        <span class="eyebrow">Applications</span>
        <h2>Where This Category Is Used</h2>
      </div>
      <div class="grid grid--2">
        {cat.applications.map((a) => (
          <div class="card" style="padding:20px 24px;">
            <h3 style="font-size:1rem;">{a}</h3>
          </div>
        ))}
      </div>
    </div>
  </section>

  {cat.slug === 'jaw-crusher-wear-parts' && (
    <section class="section">
      <div class="container">
        <div class="sec-head">
          <span class="eyebrow">Before you request a quote</span>
          <h2>Jaw Plate Quote Checklist</h2>
          <p>Share the details you have. A part number or clear photos are enough to start a technical review; missing details can be confirmed afterward.</p>
        </div>
        <div class="grid grid--3">
          {[
            'Crusher brand, model and series; fixed or movable plate position.',
            'Part number, drawing or key dimensions; include the tooth or chamber profile if known.',
            'Feed rock and typical feed size, plus the closed-side setting (CSS) if available.',
            'Current plate life in hours or tonnes, and the wear or failure pattern.',
            'Photos of the working face, back and mounting face; include a scale where possible.',
            'Order quantity and delivery country so tooling, inspection and freight can be reviewed.',
          ].map((item, i) => (
            <div class="card" style="padding:22px 24px;">
              <h3 style="font-size:1rem;margin-bottom:8px;">{String(i + 1).padStart(2, '0')}</h3>
              <p style="color:var(--muted);">{item}</p>
            </div>
          ))}
        </div>
        <p style="font-size:0.85rem;color:var(--muted);margin-top:18px;">Recommendations depend on the actual machine reference and operating conditions; the checklist does not replace drawing or sample confirmation.</p>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <div class="sec-head">
        <span class="eyebrow">Technical specifications</span>
        <h2>Specifications We Confirm Before Production</h2>
        <p>Material, machining and inspection scope are agreed in review — so the part and the paperwork match your requirement.</p>
      </div>
      <div class="table-wrap">
        <table>
          <tbody>
            {cat.specs.map((s) => {
              const i = s.indexOf(':');
              return (
                <tr>
                  <td style="width:220px;font-weight:700;color:var(--ink);background:var(--bg-tint);">{s.slice(0, i)}</td>
                  <td>{s.slice(i + 1).trim()}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p style="font-size:0.85rem;color:var(--muted);margin-top:12px;">Specific values depend on the part reference, drawing and working conditions — send the requirement and we confirm them in the technical review.</p>
    </div>
  </section>

  {deepDive && (
    <section class="section">
      <div class="container" style="max-width:920px;">
        <div class="sec-head">
          <span class="eyebrow">Technical notes</span>
          <h2>Specifying {cat.cardTitle} for Your Duty</h2>
          <p>How this part family behaves in service, how it fails, and what to record before the next set is ordered.</p>
        </div>
        {deepDive.sections.map((s) => (
          <div style="margin-top:38px;">
            <h3 style="font-size:1.22rem;margin-bottom:14px;">{s.heading}</h3>
            {s.paragraphs.map((p) => (
              <p style="font-size:1.02rem;line-height:1.85;color:var(--body);margin-bottom:16px;">{p}</p>
            ))}
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="section section--soft">
    <div class="container">
      <div class="sec-head">
        <span class="eyebrow">Selection guide</span>
        <h2>{faqHeading}</h2>
      </div>
      <FaqList items={cat.selection} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="sec-head">
        <span class="eyebrow">Related categories</span>
        <h2>Explore More Castings</h2>
        <p>Other wear-part families produced by the same review and inspection process.</p>
      </div>
      <div class="grid grid--3">
        {CATEGORIES.filter((c) => c.slug !== cat.slug).slice(0, 3).map((c) => (
          <a href={'/products/' + c.slug + '/'} class="card card--hover prod-card">
            <div class="thumb"><img src={c.heroImg} alt={c.cardTitle} loading="lazy" width="800" height="600" /></div>
            <div class="body">
              <h3>{c.cardTitle}</h3>
              <p>{c.cardDesc}</p>
              <span class="code" style="display:inline-block;margin-top:12px;">Explore →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {deepDive && deepDive.guides.length > 0 && (
    <section class="section section--soft">
      <div class="container">
        <div class="sec-head">
          <span class="eyebrow">Further reading</span>
          <h2>Related Technical Guides</h2>
          <p>Material selection, identification and inspection explained in detail.</p>
        </div>
        <div class="grid grid--3">
          {deepDive.guides.map((g) => (
            <a href={g.href} class="card card--hover" style="padding:24px 26px;">
              <h3 style="font-size:1.02rem;line-height:1.5;">{g.label}</h3>
              <span class="code" style="display:inline-block;margin-top:12px;">Read guide →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section section--soft">
    <div class="container">
      <div class="card quote-guide-callout">
        <div>
          <span class="eyebrow">Before you request a quote</span>
          <h2>Crusher Wear Parts Quotation Checklist</h2>
          <p>Have a part number, equipment model, sample or worn-part photos? See what else helps us confirm material, tooling, inspection and delivery.</p>
        </div>
        <a href="/crusher-wear-parts-quotation/" class="btn btn--primary">Use the Checklist →</a>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="sec-head">
        <span class="eyebrow">Keep reading</span>
        <h2>Where This Part Fits, and What It Is Made Of</h2>
        <p>Application notes by industry, and the material families compared by failure mode.</p>
      </div>
      <div class="grid grid--3">
        <a href="/industries/mining/" class="card card--hover" style="padding:24px 26px;">
          <h3 style="font-size:1.02rem;line-height:1.5;">Mining and ore processing</h3>
          <p style="font-size:0.9rem;color:var(--muted);margin:10px 0 0;line-height:1.6;">
            How jaw plates, cone liners and mill liners wear in a crushing circuit, and what to send with an enquiry.
          </p>
          <span class="code" style="display:inline-block;margin-top:12px;">Read notes &rarr;</span>
        </a>
        <a href="/industries/cement/" class="card card--hover" style="padding:24px 26px;">
          <h3 style="font-size:1.02rem;line-height:1.5;">Cement plants and quarries</h3>
          <p style="font-size:0.9rem;color:var(--muted);margin:10px 0 0;line-height:1.6;">
            Six wear regimes along one production line, from the primary crusher to the cooler.
          </p>
          <span class="code" style="display:inline-block;margin-top:12px;">Read notes &rarr;</span>
        </a>
        <a href="/materials/" class="card card--hover" style="padding:24px 26px;">
          <h3 style="font-size:1.02rem;line-height:1.5;">Wear-part materials</h3>
          <p style="font-size:0.9rem;color:var(--muted);margin:10px 0 0;line-height:1.6;">
            Manganese, high-chromium, chrome-moly and ductile iron compared by hardness, toughness and failure mode.
          </p>
          <span class="code" style="display:inline-block;margin-top:12px;">Compare grades &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <CtaBand
    title={'Request a Quote for ' + cat.shortName}
    text="Send the drawing, part number or equipment model and include quantity and delivery market if known. We reply with technical feedback within 12–24 hours."
    cta="Request a Quote"
  />
</BaseLayout>
