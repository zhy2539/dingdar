---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { SITE } from '../data/config';
import Turnstile from '../components/Turnstile.astro';

const path = '/request-sample/';
const sampleFields = [
  { name: 'name', label: 'Your Name *', type: 'text', required: true, placeholder: 'Full name' },
  { name: 'email', label: 'Work Email *', type: 'email', required: true, placeholder: 'name@company.com' },
  { name: 'company', label: 'Company *', type: 'text', required: true, placeholder: 'Company name' },
  { name: 'country', label: 'Country *', type: 'text', required: true, placeholder: 'Country / region' },
  { name: 'phone', label: 'Phone / WhatsApp', type: 'tel', required: false, placeholder: '+86 138 0000 0000' },
  { name: 'product', label: 'Product Interest', type: 'select', required: false, options: [
    'Jaw crusher wear parts',
    'Cone crusher wear parts',
    'Impact crusher wear parts',
    'Hammer crusher wear parts',
    'Double roll crusher parts',
    'Bucket teeth & adapters',
    'Custom castings / sample to match',
  ] },
  { name: 'quantity', label: 'Quantity / Part Reference', type: 'text', required: false, placeholder: 'e.g. 1 set of JCP-007, model & part number' },
  { name: 'reference_url', label: 'Drawing / Photo Link (optional)', type: 'url', required: false, placeholder: 'Google Drive, Dropbox or OneDrive URL' },
  { name: 'message', label: 'Application & Expected Use *', type: 'textarea', required: true, placeholder: 'Machine model, part number, material or working conditions — and what you plan to evaluate with the sample.' },
];
---

<BaseLayout
  title="Request a Sample | DINGDAR Casting"
  description="Request a sample of crusher wear parts or custom castings. Evaluation purpose and sample policy are confirmed during technical review."
  path={path}
>
  <PageHero
    eyebrow="Request a sample"
    title="Start With a Sample, Not a Gamble"
    lead="Tell us the part, machine model and what you plan to evaluate — we confirm material, dimensions and the sample policy during the technical review before anything is produced."
    img="/images/request-sample-worker.webp"
    imgAlt="Foundry worker managing molten metal near an industrial furnace"
    ctaPrimary={{ label: 'Request Sample', href: '#sample-form' }}
    ctaSecondary={{ label: 'WhatsApp Us', href: 'https://wa.me/' + SITE.whatsappTel + '?text=' + encodeURIComponent(SITE.waText) }}
    trust={[
      'Sample to match a part number',
      'Material & inspection confirmed first',
      'Feedback within 12–24 hours',
    ]}
  />

  <section class="section section--soft">
    <div class="container">
      <div class="grid grid--2" style="grid-template-columns: 1.1fr 0.9fr; gap: 40px; align-items: start;">
        <div class="card" id="sample-form" style="padding: 34px 32px;">
          <h2 style="font-size:1.5rem;">Request a Sample</h2>
          <p style="font-size:0.95rem;color:var(--muted);margin:10px 0 24px;">Fields marked * are required. We confirm sample availability, preparation time and policy in the technical review.</p>

          <form id="sample" action={SITE.formEndpoint} method="POST" novalidate>
            <div class="hp-field" aria-hidden="true">
              <label>Leave this field empty</label>
              <input type="text" name="_honey" tabindex="-1" autocomplete="off" />
            </div>
            <input type="hidden" name="_subject" value="Sample request from dingdar.com" />
            <input type="hidden" name="source_page" value="https://dingdar.com/request-sample/" />
            <input type="hidden" name="source_title" value="Request sample page" />
            <input type="hidden" name="page_language" value="en" />
            <input type="hidden" name="utm_source" value="" />
            <input type="hidden" name="utm_medium" value="" />
            <input type="hidden" name="utm_campaign" value="" />
            <input type="hidden" name="utm_content" value="" />
            <input type="hidden" name="utm_term" value="" />
            <input type="hidden" name="referrer" value="" />
            <input type="hidden" name="first_page" value="" />

            <div class="grid grid--2" style="gap: 16px;">
              {sampleFields.map((f) => (
                f.type === 'select' ? (
                  <div class="field" style="grid-column: 1 / -1;">
                    <label for={f.name}>{f.label}</label>
                    <select id={f.name} name={f.name}>
                      <option value="">Select a category</option>
                      {f.options.map((o) => <option value={o}>{o}</option>)}
                    </select>
                  </div>
                ) : f.type === 'textarea' ? (
                  <div class="field" style="grid-column: 1 / -1;">
                    <label for={f.name}>{f.label}</label>
                    <textarea id={f.name} name={f.name} rows="6" placeholder={f.placeholder} required={f.required}></textarea>
                  </div>
                ) : (
                  <div class="field" style={f.name === 'reference_url' ? 'grid-column: 1 / -1;' : undefined}>
                    <label for={f.name}>{f.label}</label>
                    <input id={f.name} name={f.name} type={f.type} placeholder={f.placeholder} required={f.required} />
                  </div>
                )
              ))}
            </div>

            <Turnstile />
            <div class="field" style="margin-top: 6px;">
              <button type="submit" class="btn btn--primary btn--lg" style="width:100%;">Request Sample</button>
              <p class="hint" id="form-status" role="status" aria-live="polite"></p>
            </div>
          </form>
        </div>

        <div>
          <div class="card" style="padding: 30px 28px; margin-bottom: 24px;">
            <h3 style="font-size:1.15rem;margin-bottom:16px;">What makes a sample useful</h3>
            <ul>
              {[
                'Part number or machine model',
                'Drawing or photos of the worn part',
                'Material or hardness you expect',
                'What you will evaluate with the sample',
              ].map((x) => (
                <li style="padding:8px 0;border-top:1px solid var(--bg-tint);display:flex;gap:10px;font-size:0.94rem;">
                  <span style="color:var(--accent);font-weight:800;">✓</span>{x}
                </li>
              ))}
            </ul>
          </div>

          <div class="card" style="padding: 30px 28px;">
            <h3 style="font-size:1.15rem;margin-bottom:16px;">Prefer to talk directly?</h3>
            <ul class="contact-list">
              <li><span class="k">WhatsApp</span><a href={'https://wa.me/' + SITE.whatsappTel + '?text=' + encodeURIComponent(SITE.waText)}>{SITE.whatsapp}</a></li>
              <li><span class="k">Sales</span><a href={'mailto:' + SITE.email}>{SITE.email}</a></li>
              <li><span class="k">Engineering</span><a href={'mailto:' + SITE.engineeringEmail}>{SITE.engineeringEmail}</a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-list li { display: flex; justify-content: space-between; gap: 16px; padding: 9px 0; border-top: 1px solid var(--bg-tint); font-size: 0.94rem; align-items: baseline; }
  .contact-list .k { color: var(--muted); font-size: 0.82rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; min-width: 96px; }
  .contact-list a { color: var(--ink); font-weight: 600; }
  .contact-list a:hover { color: var(--accent); }
  @media (max-width: 900px) { .grid--2[style] { grid-template-columns: 1fr !important; } }
</style>

<script>
  const form = document.getElementById('sample');
  const status = document.getElementById('form-status');
  const endpoint = form.getAttribute('action') || '';
  const attributionKeys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
  const attribution = new URLSearchParams(window.location.search);
  attributionKeys.forEach((key) => {
    const input = form.elements.namedItem(key);
    if (input) input.value = attribution.get(key) || '';
  });
  const referrerInput = form.elements.namedItem('referrer');
  if (referrerInput) referrerInput.value = document.referrer || '';
  const firstPageInput = form.elements.namedItem('first_page');
  try {
    const saved = JSON.parse(sessionStorage.getItem('dingdar_attribution') || '{}');
    if (firstPageInput && typeof saved.first_page === 'string') firstPageInput.value = saved.first_page;
  } catch (_) {}
  try {
    const saved = JSON.parse(sessionStorage.getItem('dingdar_attribution') || '{}');
    Object.entries(saved).forEach(([key, value]) => {
      const input = form.elements.namedItem(key);
      if (input && typeof value === 'string') input.value = value;
    });
  } catch (_) {}

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    status.textContent = '';
    const data = new FormData(form);
    if (data.get('_honey')) return;
    const name = data.get('name')?.trim();
    const email = data.get('email')?.trim();
    const country = data.get('country')?.trim();
    const message = data.get('message')?.trim();
    if (!name || !email || !country || !message) {
      status.textContent = 'Please complete all required fields.';
      status.style.color = '#d9480f';
      return;
    }
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
      status.textContent = 'Please enter a valid email address.';
      status.style.color = '#d9480f';
      return;
    }
    if (!endpoint) {
      status.innerHTML = 'The form endpoint is not configured yet. Please contact us directly: <a href="mailto:hugo@dingdar.com" style="color:#e8590c;font-weight:700;">hugo@dingdar.com</a> or <a href="https://wa.me/8619337861987?text=Hello%20DINGDAR%2C%20I%20found%20your%20website%20and%20would%20like%20to%20ask%20about%20your%20cast%20wear%20parts.%20Please%20share%20more%20details." style="color:#e8590c;font-weight:700;">WhatsApp</a>.';
      return;
    }
    try {
      const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      if (res.ok) {
        if (window.dingdarTrackEvent) await window.dingdarTrackEvent('sample_requested');
        window.location.href = '/thank-you/';
      } else {
        status.textContent = 'Something went wrong. Please try again or use WhatsApp / email.';
        status.style.color = '#d9480f';
      }
    } catch {
      status.textContent = 'Network error. Please email us at hugo@dingdar.com or message us on WhatsApp.';
      status.style.color = '#d9480f';
    }
  });
</script>
