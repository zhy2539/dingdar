---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/config';
---

<BaseLayout
  title="Inquiry Received | DINGDAR"
  description="Thank you for your inquiry. Our project team will respond with technical feedback within 12–24 hours."
  noindex={true}
  path="/thank-you/"
>
  <section class="section">
    <div class="container" style="max-width:720px;text-align:center;">
      <div class="badge" style="margin-bottom:18px;">Inquiry received</div>
      <h1>Thank You — We've Got Your Inquiry</h1>
      <p style="margin-top:18px;font-size:1.08rem;">
        Your request has been registered. Our project team reviews each inquiry as a technical
        requirement, and you can expect a first response within 12–24 hours.
      </p>
      <div class="card" style="padding:28px 30px;margin-top:32px;text-align:left;">
        <h3 style="font-size:1.05rem;margin-bottom:12px;">To speed things up, you can add:</h3>
        <ul>
          {[
            'Drawing, 3D model or part number',
            'Material or hardness requirement',
            'Equipment model and application',
            'Required quantity and delivery market',
          ].map((x) => (
            <li style="padding:8px 0;border-top:1px solid var(--bg-tint);display:flex;gap:10px;font-size:0.95rem;">
              <span style="color:var(--accent);font-weight:800;">✓</span>{x}
            </li>
          ))}
        </ul>
      </div>
      <div class="cta-row" style="display:flex;gap:14px;justify-content:center;margin-top:32px;flex-wrap:wrap;">
        <a href="/" class="btn btn--ghost">Back to Home</a>
        <a href={'https://wa.me/' + SITE.whatsappTel + '?text=' + encodeURIComponent(SITE.waText)} class="btn btn--primary">Message Us on WhatsApp</a>
      </div>
    </div>
  </section>
</BaseLayout>
